<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Темная тема - цвета -->
    <Color x:Key="PrimaryColor">#FF66BB6A</Color>
    <Color x:Key="PrimaryDarkColor">#FF5A9E5E</Color>
    <Color x:Key="PrimaryDarkerColor">#FF4D8A51</Color>
    <Color x:Key="AccentColor">#FF42A5F5</Color>
    <Color x:Key="ErrorColor">#FFEF5350</Color>
    <Color x:Key="WarningColor">#FFFFB74D</Color>
    <Color x:Key="SuccessColor">#FF66BB6A</Color>
    <Color x:Key="InfoColor">#FF42A5F5</Color>

    <Color x:Key="TextColor">#FFFFFFFF</Color>
    <Color x:Key="TextLightColor">#FFB0B0B0</Color>
    <Color x:Key="TextDarkColor">#FFE0E0E0</Color>
    <Color x:Key="TextDisabledColor">#FF757575</Color>

    <Color x:Key="BorderColor">#FF555555</Color>
    <Color x:Key="BorderLightColor">#FF666666</Color>
    <Color x:Key="BorderDarkColor">#FF444444</Color>

    <Color x:Key="BackgroundColor">#FF2D2D2D</Color>
    <Color x:Key="BackgroundLightColor">#FF383838</Color>
    <Color x:Key="BackgroundDarkColor">#FF252525</Color>

    <Color x:Key="PanelBackgroundColor">#FF383838</Color>
    <Color x:Key="HeaderBackgroundColor">#FF404040</Color>
    <Color x:Key="WindowBackgroundColor">#FF252525</Color>

    <Color x:Key="DataGridAlternatingRowColor">#FF353535</Color>
    <Color x:Key="DataGridHeaderColor">#FF404040</Color>
    <Color x:Key="DataGridSelectedRowColor">#FF1E3A5F</Color>
    <Color x:Key="DataGridHoverRowColor">#FF3A3A3A</Color>
    <Color x:Key="DataGridSelectionColor">#FF1E3A5F</Color>

    <Color x:Key="ToolBarBackgroundColor">#FF383838</Color>
    <Color x:Key="StatusBarBackgroundColor">#FF404040</Color>
    <Color x:Key="MenuBackgroundColor">#FF404040</Color>

    <Color x:Key="PopupBackgroundColor">#FF383838</Color>
    <Color x:Key="PopupBorderColor">#FF555555</Color>

    <Color x:Key="ScrollBarBackgroundColor">#FF404040</Color>
    <Color x:Key="ScrollBarThumbColor">#FF666666</Color>
    <Color x:Key="ScrollBarThumbHoverColor">#FF808080</Color>


    <!-- Кисти -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
    <SolidColorBrush x:Key="PrimaryDarkerBrush" Color="{StaticResource PrimaryDarkerColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLightColor}"/>
    <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDarkColor}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="BorderDarkBrush" Color="{StaticResource BorderDarkColor}"/>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackgroundLightBrush" Color="{StaticResource BackgroundLightColor}"/>
    <SolidColorBrush x:Key="BackgroundDarkBrush" Color="{StaticResource BackgroundDarkColor}"/>

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="{StaticResource HeaderBackgroundColor}"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>

    <SolidColorBrush x:Key="DataGridAlternatingRowBrush" Color="{StaticResource DataGridAlternatingRowColor}"/>
    <SolidColorBrush x:Key="DataGridHeaderBrush" Color="{StaticResource DataGridHeaderColor}"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBrush" Color="{StaticResource DataGridSelectedRowColor}"/>
    <SolidColorBrush x:Key="DataGridHoverRowBrush" Color="{StaticResource DataGridHoverRowColor}"/>

    <!-- Цвет текста для выбранной строки таблицы (может переопределяться темой) -->
    <SolidColorBrush x:Key="DataGridSelectedForegroundBrush" Color="White"/>

    <SolidColorBrush x:Key="ToolBarBackgroundBrush" Color="{StaticResource ToolBarBackgroundColor}"/>
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="{StaticResource StatusBarBackgroundColor}"/>
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="{StaticResource MenuBackgroundColor}"/>

    <SolidColorBrush x:Key="PopupBackgroundBrush" Color="{StaticResource PopupBackgroundColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush" Color="{StaticResource PopupBorderColor}"/>

    <SolidColorBrush x:Key="ScrollBarBackgroundBrush" Color="{StaticResource ScrollBarBackgroundColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource ScrollBarThumbColor}"/>
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource ScrollBarThumbHoverColor}"/>

    <SolidColorBrush x:Key="DataGridSelectionBrush" Color="{StaticResource DataGridSelectionColor}"/>

    <SolidColorBrush x:Key="HighlightBrush" Color="#FF42A5F5"/>
    <SolidColorBrush x:Key="HighlightTextBrush" Color="White"/>

</ResourceDictionary>