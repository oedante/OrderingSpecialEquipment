<Application x:Class="OrderingSpecialEquipment.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OrderingSpecialEquipment.Controls" 
             xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
             Startup="Application_Startup"
             DispatcherUnhandledException="Application_DispatcherUnhandledException">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Material Design resources (themes and color palettes) -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.Green.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.LightBlue.xaml" />

                <!-- Сначала загружаем локальную тему -->
                <ResourceDictionary Source="Resources/Themes/LightTheme.xaml"/>
                <!-- Потом загружаем стили -->
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Конвертеры -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:BooleanToTextConverter x:Key="BoolToText"/>

            <!-- Глобальные стили по умолчанию - только для элементов, которые точно не вызовут конфликтов -->
            <Style TargetType="Window" BasedOn="{StaticResource ModernWindow}"/>
            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}"/>
            <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}"/>
            <Style TargetType="PasswordBox" BasedOn="{StaticResource ModernPasswordBox}"/>
            <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItem}"/>
            <Style TargetType="DatePicker" BasedOn="{StaticResource ModernDatePicker}"/>
            <Style TargetType="CheckBox" BasedOn="{StaticResource ModernCheckBox}"/>
            <Style TargetType="RadioButton" BasedOn="{StaticResource ModernRadioButton}"/>
            <Style TargetType="ListBox" BasedOn="{StaticResource ModernListBox}"/>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ModernListBoxItem}"/>
            <Style TargetType="TabControl" BasedOn="{StaticResource ModernTabControl}"/>
            <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}"/>
            <Style TargetType="GroupBox" BasedOn="{StaticResource ModernGroupBox}"/>
            <Style TargetType="ToolBar" BasedOn="{StaticResource ModernToolBar}"/>
            <Style TargetType="StatusBar" BasedOn="{StaticResource ModernStatusBar}"/>
            <Style TargetType="Menu" BasedOn="{StaticResource ModernMenu}"/>
            <Style TargetType="MenuItem" BasedOn="{StaticResource ModernMenuItem}"/>
            <Style TargetType="Separator" BasedOn="{StaticResource ModernSeparator}"/>
            <Style TargetType="Border" BasedOn="{StaticResource ModernBorder}"/>
            <Style TargetType="ScrollViewer" BasedOn="{StaticResource ModernScrollViewer}"/>
            <Style TargetType="ProgressBar" BasedOn="{StaticResource ModernProgressBar}"/>

            <!-- Стили для кастомных контролов - используем правильный префикс "controls" -->
            <Style TargetType="controls:NumericTextBox" BasedOn="{StaticResource ModernNumericTextBox}"/>
            <Style TargetType="controls:SearchableComboBox" BasedOn="{StaticResource ModernSearchableComboBox}"/>
            <Style TargetType="controls:TimePicker" BasedOn="{StaticResource ModernTimePicker}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>