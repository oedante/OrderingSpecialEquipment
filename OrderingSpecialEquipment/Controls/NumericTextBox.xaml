<UserControl x:Class="OrderingSpecialEquipment.Controls.NumericTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OrderingSpecialEquipment.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="150"
             x:Name="NumericTextBoxControl">

    <UserControl.Resources>
        <!-- Стиль для кнопок-стрелок (вертикальное расположение) -->
        <Style x:Key="VerticalSpinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для контейнера стрелок -->
        <Style x:Key="SpinButtonsPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Текстовое поле -->
        <TextBox x:Name="ValueTextBox"
                 Grid.Column="0"
                 Text="{Binding ElementName=NumericTextBoxControl, Path=TextValue, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource ModernTextBox}"
                 Height="32"
                 PreviewTextInput="ValueTextBox_PreviewTextInput"
                 LostFocus="ValueTextBox_LostFocus"
                 IsEnabled="{Binding ElementName=NumericTextBoxControl, Path=ControlIsEnabled}"
                 VerticalContentAlignment="Center"/>

        <!-- Вертикальная панель с кнопками-стрелками -->
        <StackPanel Grid.Column="1" Style="{StaticResource SpinButtonsPanel}">
            <Button Content="▲"
                    Margin="2,0,0,2"
                    Style="{StaticResource VerticalSpinButton}"
                    Click="Increase_Click"
                    IsEnabled="{Binding ElementName=NumericTextBoxControl, Path=ControlIsEnabled}"/>
            <Button Content="▼"
                    Style="{StaticResource VerticalSpinButton}"
                    Click="Decrease_Click"
                    IsEnabled="{Binding ElementName=NumericTextBoxControl, Path=ControlIsEnabled}"/>
        </StackPanel>
    </Grid>
</UserControl>