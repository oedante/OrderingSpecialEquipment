<UserControl x:Class="OrderingSpecialEquipment.Controls.TimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
             xmlns:local="clr-namespace:OrderingSpecialEquipment.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="200"
             x:Name="TimePickerControl">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- Стиль для кнопок управления временем (вертикальное расположение) -->
        <Style x:Key="TimeSpinButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="15"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для контейнера стрелок -->
        <Style x:Key="SpinButtonsPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Текстовое поле для ввода времени -->
            <TextBox x:Name="TimeTextBox"
                     Grid.Column="0"
                     Text="{Binding ElementName=TimePickerControl, Path=TimeText, UpdateSourceTrigger=PropertyChanged}"
                     Height="32"
                     MaxLength="5"
                     LostFocus="TimeTextBox_LostFocus"
                     PreviewTextInput="TimeTextBox_PreviewTextInput"
                     PreviewKeyDown="TimeTextBox_PreviewKeyDown"
                     VerticalContentAlignment="Center"
                     DataObject.Pasting="TimeTextBox_Pasting">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=TimePickerControl, Path=HasError}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="ToolTip" Value="{Binding ElementName=TimePickerControl, Path=ErrorText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <!-- Вертикальная панель с кнопками-стрелками -->
            <StackPanel Grid.Column="1" Style="{StaticResource SpinButtonsPanel}">
                <Button Content="▲"
                        Margin="2,0,0,2"
                        Style="{StaticResource TimeSpinButton}"
                        Click="IncreaseHour_Click"/>
                <Button Content="▼"
                        Style="{StaticResource TimeSpinButton}"
                        Click="DecreaseHour_Click"/>
            </StackPanel>
        </Grid>

        <!-- Error hint -->
        <TextBlock x:Name="ErrorTextBlock"
                   Grid.Row="1"
                   Text="{Binding ElementName=TimePickerControl, Path=ErrorText}"
                   Foreground="{DynamicResource ErrorBrush}"
                   FontSize="11"
                   Margin="8,4,0,0"
                   Visibility="{Binding ElementName=TimePickerControl, Path=HasError, Converter={StaticResource BoolToVis}}"/>
    </Grid>
</UserControl>