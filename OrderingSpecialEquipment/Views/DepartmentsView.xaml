<Window x:Class="OrderingSpecialEquipment.Views.DepartmentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="800"
        Title="Справочник отделов" 
        WindowStartupLocation="CenterOwner"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Style="{StaticResource ModernToolBar}">
            <Button x:Name="btnAdd" Content="➕ Добавить" 
                    Click="BtnAdd_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать" 
                    Click="BtnEdit_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnDelete" Content="🗑️ Удалить" 
                    Click="BtnDelete_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" 
                    Click="BtnRefresh_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <CheckBox x:Name="chkShowInactive" Content="Показывать неактивные" 
                      VerticalAlignment="Center" Margin="5,0" 
                      Checked="ChkShowInactive_Changed" 
                      Unchecked="ChkShowInactive_Changed"
                      Style="{StaticResource ModernCheckBox}"/>
        </ToolBar>

        <!-- Таблица отделов -->
        <DataGrid x:Name="dgDepartments" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="DgDepartments_MouseDoubleClick"
                  Margin="0,5"
                  Style="{StaticResource ModernDataGrid}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  Background="{DynamicResource BackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="60"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="80"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="130"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования -->
        <Popup x:Name="EditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="400">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle" 
                               Text="Добавление отдела" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Наименование:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtName" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <CheckBox x:Name="chkIsActive" 
                              Content="Активен" 
                              IsChecked="True" 
                              Margin="0,5"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSave" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSave_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancel" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancel_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>