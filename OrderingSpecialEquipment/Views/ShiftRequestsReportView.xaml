<Window x:Class="OrderingSpecialEquipment.Views.ShiftRequestsReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1200"
        Title="Детализация заявок" 
        WindowStartupLocation="CenterOwner"
        Width="1200" Height="600"
        MinWidth="900" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель параметров отчета -->
        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackgroundBrush}" 
                Padding="10" 
                CornerRadius="4" 
                Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Отдел:" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <ComboBox Grid.Column="1" x:Name="cmbDepartment" 
                          Height="30" 
                          Margin="5,0"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Style="{StaticResource ModernComboBox}"/>

                <TextBlock Grid.Column="2" 
                           Text="Период:" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0">
                    <DatePicker x:Name="dpDateFrom" 
                                Width="120" 
                                Height="30" 
                                Margin="0,0,5,0"
                                Style="{StaticResource ModernDatePicker}"/>
                    <TextBlock Text="—" 
                               VerticalAlignment="Center" 
                               Margin="2,0"
                               Foreground="{DynamicResource TextBrush}"/>
                    <DatePicker x:Name="dpDateTo" 
                                Width="120" 
                                Height="30" 
                                Margin="5,0,0,0"
                                Style="{StaticResource ModernDatePicker}"/>
                </StackPanel>

                <Button Grid.Column="4" x:Name="btnGenerate" 
                        Content="Сформировать отчет" 
                        Width="150" 
                        Height="35" 
                        HorizontalAlignment="Right" 
                        Margin="5"
                        Click="BtnGenerate_Click"
                        Style="{StaticResource ModernButton}"/>

                <Button Grid.Column="4" x:Name="btnExport" 
                        Content="📊 Экспорт в Excel" 
                        Width="150" 
                        Height="35" 
                        HorizontalAlignment="Right" 
                        Margin="5,0,160,0"
                        Click="BtnExport_Click"
                        Style="{StaticResource ModernButton}"
                        Background="{DynamicResource AccentBrush}"/>
            </Grid>
        </Border>

        <!-- Фильтры -->
        <Border Grid.Row="1" 
                Background="{DynamicResource HeaderBackgroundBrush}" 
                Padding="10" 
                CornerRadius="4" 
                Margin="0,0,0,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Техника:" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <ComboBox Grid.Column="1" x:Name="cmbEquipment" 
                          Height="30" 
                          Margin="5,0"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Style="{StaticResource ModernComboBox}"/>

                <CheckBox Grid.Column="2" x:Name="chkShowOnlyWorked" 
                          Content="Только отработанные" 
                          VerticalAlignment="Center" 
                          Margin="15,0,0,0"
                          Style="{StaticResource ModernCheckBox}"/>

                <CheckBox Grid.Column="3" x:Name="chkGroupByEquipment" 
                          Content="Группировать по технике" 
                          VerticalAlignment="Center" 
                          Margin="15,0,0,0"
                          Checked="ChkGroupByEquipment_Changed"
                          Unchecked="ChkGroupByEquipment_Changed"
                          Style="{StaticResource ModernCheckBox}"/>
            </Grid>
        </Border>

        <!-- Таблица отчета -->
        <DataGrid x:Name="dgReport" Grid.Row="2" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  Margin="0,5"
                  RowHeight="30"
                  Style="{StaticResource ModernDataGrid}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  Background="{DynamicResource BackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" 
                                    Binding="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                    Width="90"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Смена" 
                                    Binding="{Binding ShiftName}" 
                                    Width="70"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Отдел" 
                                    Binding="{Binding DepartmentName}" 
                                    Width="120"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Склад" 
                                    Binding="{Binding WarehouseName}" 
                                    Width="120"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Территория" 
                                    Binding="{Binding AreaName}" 
                                    Width="120"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Техника" 
                                    Binding="{Binding EquipmentName}" 
                                    Width="150"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Госномер" 
                                    Binding="{Binding PlateNumber}" 
                                    Width="100"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Арендодатель" 
                                    Binding="{Binding LessorName}" 
                                    Width="150"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Кол-во" 
                                    Binding="{Binding RequestedCount}" 
                                    Width="50"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Часы" 
                                    Binding="{Binding WorkedHours}" 
                                    Width="60"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Стоимость" 
                                    Binding="{Binding ActualCost, Converter={StaticResource CurrencyFormat}}" 
                                    Width="100"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Отработано" 
                                    Binding="{Binding IsWorked, Converter={StaticResource BoolToYesNo}}" 
                                    Width="80"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Комментарий" 
                                    Binding="{Binding Comment}" 
                                    Width="200"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итоговая строка -->
        <Border Grid.Row="3" 
                Background="{DynamicResource HeaderBackgroundBrush}" 
                Padding="10" 
                CornerRadius="4" 
                Margin="0,5,0,0"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="ИТОГО:" 
                           FontWeight="Bold" 
                           FontSize="14"
                           Foreground="{DynamicResource TextBrush}"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Всего часов: " 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="txtTotalHours" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Всего стоимость: " 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="txtTotalCost" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Статус бар -->
        <StatusBar Grid.Row="4" 
                   Style="{StaticResource ModernStatusBar}"
                   Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" 
                           Text="Готов" 
                           Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>