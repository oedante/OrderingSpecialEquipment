<Window x:Class="OrderingSpecialEquipment.Views.RoleEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:local="clr-namespace:OrderingSpecialEquipment.Views"
        mc:Ignorable="d" 
        d:DesignHeight="700" d:DesignWidth="700"
        Title="Редактирование роли" 
        WindowStartupLocation="CenterOwner"
        Width="700" Height="700"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Конвертер для уровня доступа -->
        <local:AccessLevelToTextConverter x:Key="AccessLevelToText"/>

        <!-- Стиль для ComboBox в таблице -->
        <Style x:Key="AccessLevelComboBox" TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================= -->
        <!-- ОСНОВНАЯ ИНФОРМАЦИЯ О РОЛИ                    -->
        <!-- ============================================= -->
        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackgroundBrush}" 
                Padding="15" 
                CornerRadius="4" 
                Margin="0,0,0,15"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Код роли -->
                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Код роли:" 
                           VerticalAlignment="Center" 
                           Margin="5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="1" 
                         x:Name="txtCode" 
                         Height="30" 
                         Margin="5"
                         Style="{StaticResource ModernTextBox}"/>

                <!-- Наименование -->
                <TextBlock Grid.Row="0" Grid.Column="2" 
                           Text="Наименование:" 
                           VerticalAlignment="Center" 
                           Margin="5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox Grid.Row="0" Grid.Column="3" 
                         x:Name="txtName" 
                         Height="30" 
                         Margin="5"
                         Style="{StaticResource ModernTextBox}"/>

                <!-- Описание -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Описание:" 
                           VerticalAlignment="Center" 
                           Margin="5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                         x:Name="txtDescription" 
                         Height="30" 
                         Margin="5"
                         Style="{StaticResource ModernTextBox}"/>
            </Grid>
        </Border>

        <!-- ============================================= -->
        <!-- ТАБЛИЦА ПРАВ ДОСТУПА                           -->
        <!-- ============================================= -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Style="{StaticResource ModernScrollViewer}">
            <StackPanel Margin="0,0,10,0">

                <!-- Заголовок секции -->
                <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                        Padding="8" 
                        CornerRadius="4,4,0,0" 
                        Margin="0,5,0,0">
                    <TextBlock Text="Права доступа к таблицам" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <!-- Заголовки колонок -->
                <Grid Margin="5,2,5,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" 
                               Text="Таблица" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="1" 
                               Text="Уровень доступа" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Grid.Column="2" 
                               Text="Описание" 
                               FontWeight="SemiBold" 
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}"/>
                </Grid>

                <!-- Departments -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Departments (Отделы)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbDepartmentsAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление отделами" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- Equipments -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Equipments (Техника)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbEquipmentsAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление техникой" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- LessorOrganizations -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="LessorOrganizations (Арендодатели)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbLessorOrganizationsAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление арендодателями" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- LicensePlates -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="LicensePlates (Госномера)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbLicensePlatesAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление госномерами" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- EquipmentDependencies -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="EquipmentDependencies (Зависимости)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbEquipmentDependenciesAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление зависимостями" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- TransportProgram -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="TransportProgram (Транспортная программа)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbTransportProgramAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление программой" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- ShiftRequests -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="ShiftRequests (Заявки)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbShiftRequestsAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление заявками" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- Warehouses -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Warehouses (Склады)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbWarehousesAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление складами" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- WarehouseAreas -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="WarehouseAreas (Территории)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbWarehouseAreasAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление территориями" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- Users -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Users (Пользователи)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbUsersAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление пользователями" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- Roles -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="Roles (Роли)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbRolesAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление ролями" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- UserDepartmentAccess -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="UserDepartmentAccess (Доступ к отделам)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbUserDepartmentAccessAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление доступом" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- UserWarehouseAccess -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="UserWarehouseAccess (Доступ к складам)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbUserWarehouseAccessAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление доступом" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- UserFavorites -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="UserFavorites (Избранное)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbUserFavoritesAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Управление избранным" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- AuditLogs -->
                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="AuditLogs (Журнал аудита)" 
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <ComboBox Grid.Column="1" 
                                  x:Name="cmbAuditLogsAccess" 
                                  SelectedIndex="0"
                                  Style="{StaticResource AccessLevelComboBox}">
                            <ComboBoxItem Content="Запрещено" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Только чтение" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                            <ComboBoxItem Content="Полный доступ" Tag="2" Style="{StaticResource ModernComboBoxItem}"/>
                        </ComboBox>
                        <TextBlock Grid.Column="2" 
                                   Text="Просмотр журнала" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextLightBrush}"/>
                    </Grid>
                </Border>

                <!-- Разделитель -->
                <Border Height="10" Margin="0,5"/>

                <!-- ============================================= -->
                <!-- СПЕЦИАЛЬНЫЕ ПРАВА                              -->
                <!-- ============================================= -->
                <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                        Padding="8" 
                        CornerRadius="4,4,0,0" 
                        Margin="0,5,0,0">
                    <TextBlock Text="Специальные права" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox x:Name="chkExportData" 
                                      Content="Экспорт данных" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="chkViewReports" 
                                      Content="Просмотр отчетов" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="chkManageAllDepartments" 
                                      Content="Управление всеми отделами" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <CheckBox x:Name="chkManageUsers" 
                                      Content="Управление пользователями" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="chkSystemAdmin" 
                                      Content="Системный администратор" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                            <CheckBox x:Name="chkConfigureConnection" 
                                      Content="Настройка подключения к БД" 
                                      Margin="5"
                                      Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============================================= -->
                <!-- ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ                       -->
                <!-- ============================================= -->
                <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                        Padding="8" 
                        CornerRadius="4,4,0,0" 
                        Margin="0,5,0,0">
                    <TextBlock Text="Дополнительные настройки" 
                               FontWeight="Bold" 
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                </Border>

                <Border BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="0,0,0,1" 
                        Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" 
                                  x:Name="chkIsSystem" 
                                  Content="Системная роль" 
                                  Margin="5"
                                  Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox Grid.Column="1" 
                                  x:Name="chkIsActive" 
                                  Content="Активна" 
                                  IsChecked="True" 
                                  Margin="5"
                                  Style="{StaticResource ModernCheckBox}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ============================================= -->
        <!-- КНОПКИ                                         -->
        <!-- ============================================= -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button x:Name="btnSave" 
                    Content="Сохранить" 
                    Width="100" 
                    Height="35" 
                    Margin="5" 
                    Click="BtnSave_Click"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="100" 
                    Height="35" 
                    Margin="5" 
                    Click="BtnCancel_Click"
                    Style="{StaticResource ModernButton}"
                    Background="#FF9E9E9E"/>
        </StackPanel>
    </Grid>
</Window>