<Window x:Class="OrderingSpecialEquipment.Views.UserEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        mc:Ignorable="d" d:DesignWidth="500"
        Title="Редактирование пользователя" 
        WindowStartupLocation="CenterOwner"
        Width="500" Height="541"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid Margin="20" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" 
                      VerticalScrollBarVisibility="Auto"
                      Style="{StaticResource ModernScrollViewer}">
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="Windows логин:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtWindowsLogin" 
                         Height="30" 
                         Margin="0,0,0,5"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="Полное имя:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtFullName" 
                         Height="30" 
                         Margin="0,0,0,5"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="Email:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtEmail" 
                         Height="30" 
                         Margin="0,0,0,5"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="Телефон:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox x:Name="txtPhone" 
                         Height="30" 
                         Margin="0,0,0,5"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Text="Роль:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="cmbRole" 
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Height="30" 
                          Margin="0,0,0,5"
                          Style="{StaticResource ModernComboBox}"/>

                <TextBlock Text="Отдел по умолчанию:" 
                           Margin="0,5"
                           Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="cmbDefaultDepartment" 
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          Height="30" 
                          Margin="0,0,0,5"
                          Style="{StaticResource ModernComboBox}"/>

                <CheckBox x:Name="chkHasAllDepartments" 
                          Content="Доступ ко всем отделам" 
                          Margin="0,5"
                          Style="{StaticResource ModernCheckBox}"/>
                <CheckBox x:Name="chkIsActive" 
                          Content="Активен" 
                          IsChecked="True" 
                          Margin="0,5"
                          Style="{StaticResource ModernCheckBox}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,10,0,0">
            <Button x:Name="btnSave" 
                    Content="Сохранить" 
                    Width="100" 
                    Height="35" 
                    Margin="5" 
                    Click="BtnSave_Click"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="100" 
                    Height="35" 
                    Margin="5" 
                    Click="BtnCancel_Click"
                    Style="{StaticResource ModernButton}"
                    Background="#FF9E9E9E"/>
        </StackPanel>
    </Grid>
</Window>