<Window x:Class="OrderingSpecialEquipment.Views.UserSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="900"
        Title="Настройки пользователей" 
        WindowStartupLocation="CenterOwner"
        Width="900" Height="600"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Style="{StaticResource ModernToolBar}">
            <StackPanel Orientation="Horizontal" >
                <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource TextBrush}"/>
                <ComboBox x:Name="cmbUsers" 
                          ItemsSource="{Binding AllUsers}"
                          SelectedItem="{Binding SelectedUser}"
                          DisplayMemberPath="FullName"
                          Width="200" 
                          Height="30" 
                          Margin="5,0"
                          Style="{StaticResource ModernComboBox}"/>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <Button x:Name="btnRefresh" 
                        Command="{Binding LoadSettingsCommand}"
                        ToolTip="Обновить"
                        Width="30" Height="30"
                        Margin="2"
                        Style="{StaticResource IconButton}">
                    <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppPackIcon}"/>
                </Button>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <Button x:Name="btnAdd" 
                        Command="{Binding AddSettingCommand}"
                        ToolTip="Добавить настройку"
                        Width="30" Height="30"
                        Margin="2"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource PrimaryBrush}">
                    <materialDesign:PackIcon Kind="Plus" Foreground="White" Width="16" Height="16"/>
                </Button>

                <Button x:Name="btnClearAll" 
                        Command="{Binding ClearAllSettingsCommand}"
                        ToolTip="Удалить все настройки"
                        Width="30" Height="30"
                        Margin="2"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource ErrorBrush}">
                    <materialDesign:PackIcon Kind="DeleteSweep" Foreground="White" Width="16" Height="16"/>
                </Button>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <Button x:Name="btnExport" 
                        Command="{Binding ExportSettingsCommand}"
                        ToolTip="Экспорт в JSON"
                        Width="30" Height="30"
                        Margin="2"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource AccentBrush}">
                    <materialDesign:PackIcon Kind="Export" Foreground="White" Width="16" Height="16"/>
                </Button>

                <Button x:Name="btnImport" 
                        Command="{Binding ImportSettingsCommand}"
                        ToolTip="Импорт из JSON"
                        Width="30" Height="30"
                        Margin="2"
                        Style="{StaticResource IconButton}"
                        Background="{DynamicResource AccentBrush}">
                    <materialDesign:PackIcon Kind="Import" Foreground="White" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </ToolBar>

        <!-- Панель добавления новой настройки -->
        <Border Grid.Row="1" 
                Background="{DynamicResource HeaderBackgroundBrush}" 
                Padding="10" 
                CornerRadius="4" 
                Margin="0,5,0,10"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Ключ:" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox Grid.Column="1" 
                         Text="{Binding NewSettingKey, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" 
                         Margin="5,0"
                         Style="{StaticResource ModernTextBox}"/>

                <TextBlock Grid.Column="2" 
                           Text="Значение:" 
                           VerticalAlignment="Center" 
                           Margin="5,0"
                           Foreground="{DynamicResource TextBrush}"/>
                <TextBox Grid.Column="3" 
                         Text="{Binding NewSettingValue, UpdateSourceTrigger=PropertyChanged}"
                         Height="30" 
                         Margin="5,0"
                         Style="{StaticResource ModernTextBox}"/>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button Command="{Binding SaveSettingCommand}"
                            Width="80"
                            Height="30"
                            Margin="2"
                            Style="{StaticResource ModernButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Margin="0,0,3,0" Foreground="White"/>
                            <TextBlock Text="Сохранить" Foreground="White" FontSize="11"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelEditCommand}"
                            Width="70"
                            Height="30"
                            Margin="2"
                            Style="{StaticResource ModernButton}"
                            Background="#FF9E9E9E">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" Margin="0,0,3,0" Foreground="White"/>
                            <TextBlock Text="Отмена" Foreground="White" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица настроек -->
        <DataGrid x:Name="dgSettings" Grid.Row="1" 
                  ItemsSource="{Binding Settings}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectedItem="{Binding SelectedSetting}"
                  Margin="0,5"
                  RowHeight="30"
                  Style="{StaticResource ModernDataGrid}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  Background="{DynamicResource BackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}">

            <DataGrid.ContextMenu>
                <ContextMenu Background="{DynamicResource PopupBackgroundBrush}" 
                            BorderBrush="{DynamicResource PopupBorderBrush}">
                    <MenuItem Header="Удалить" 
                              Command="{Binding DeleteSettingCommand}" 
                              CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              Style="{StaticResource ModernMenuItem}"/>
                    <MenuItem Header="Редактировать" 
                              Command="{Binding AddSettingCommand}" 
                              Style="{StaticResource ModernMenuItem}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Ключ" 
                                    Binding="{Binding Key}" 
                                    Width="200"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Значение" 
                                    Binding="{Binding DisplayValue}" 
                                    Width="300"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Тип" 
                                    Binding="{Binding ValueType}" 
                                    Width="100"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTemplateColumn Header="Действия" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Command="{Binding DataContext.DeleteSettingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="28"
                                        Height="28"
                                        Margin="2"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="Удалить"
                                        Background="{DynamicResource ErrorBrush}">
                                    <materialDesign:PackIcon Kind="Delete" Foreground="White" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" 
                           Text="{Binding StatusMessage}" 
                           Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Всего настроек: " Foreground="{DynamicResource TextLightBrush}"/>
                    <TextBlock Text="{Binding Settings.Count}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Margin="0,0,5,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsLoading, Converter={StaticResource BooleanToColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding IsLoading, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Загрузка...;Готов'}" 
                               Foreground="{DynamicResource TextLightBrush}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>