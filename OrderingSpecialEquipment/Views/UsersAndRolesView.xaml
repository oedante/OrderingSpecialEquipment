<Window x:Class="OrderingSpecialEquipment.Views.UsersAndRolesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="700" d:DesignWidth="1000"
        Title="Пользователи и права доступа" 
        WindowStartupLocation="CenterOwner"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="500">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
    </Window.Resources>

    <TabControl Margin="10">
        <!-- Вкладка Роли -->
        <TabItem Header="Роли">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель инструментов ролей -->
                <ToolBar Grid.Row="0" Background="#FFF0F0F0" Height="40">
                    <Button x:Name="btnAddRole" Content="➕ Добавить роль" Click="BtnAddRole_Click" Margin="2" Padding="8,3"/>
                    <Button x:Name="btnEditRole" Content="✏️ Редактировать роль" Click="BtnEditRole_Click" Margin="2" Padding="8,3"/>
                    <Button x:Name="btnDeleteRole" Content="🗑️ Удалить роль" Click="BtnDeleteRole_Click" Margin="2" Padding="8,3"/>
                    <Separator/>
                    <Button x:Name="btnRefreshRoles" Content="🔄 Обновить" Click="BtnRefreshRoles_Click" Margin="2" Padding="8,3"/>
                </ToolBar>

                <!-- Таблица ролей -->
                <DataGrid x:Name="dgRoles" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DgRoles_MouseDoubleClick"
                          Margin="0,5"
                          RowHeight="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                        <DataGridCheckBoxColumn Header="Системная" Binding="{Binding IsSystem}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Активна" Binding="{Binding IsActive}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Статус бар -->
                <StatusBar Grid.Row="2" Background="#FFF0F0F0">
                    <StatusBarItem>
                        <TextBlock x:Name="txtRolesStatus" Text="Готов"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>

        <!-- Вкладка Пользователи -->
        <TabItem Header="Пользователи">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Панель инструментов пользователей -->
                <ToolBar Grid.Row="0" Background="#FFF0F0F0" Height="40">
                    <Button x:Name="btnAddUser" Content="➕ Добавить пользователя" Click="BtnAddUser_Click" Margin="2" Padding="8,3"/>
                    <Button x:Name="btnEditUser" Content="✏️ Редактировать пользователя" Click="BtnEditUser_Click" Margin="2" Padding="8,3"/>
                    <Button x:Name="btnDeleteUser" Content="🗑️ Удалить пользователя" Click="BtnDeleteUser_Click" Margin="2" Padding="8,3"/>
                    <Separator/>
                    <Button x:Name="btnRefreshUsers" Content="🔄 Обновить" Click="BtnRefreshUsers_Click" Margin="2" Padding="8,3"/>
                    <Separator/>
                    <CheckBox x:Name="chkShowInactiveUsers" Content="Показывать неактивных" 
                              VerticalAlignment="Center" Margin="5,0" Checked="ChkShowInactiveUsers_Changed" Unchecked="ChkShowInactiveUsers_Changed"/>
                </ToolBar>

                <!-- Таблица пользователей -->
                <DataGrid x:Name="dgUsers" Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DgUsers_MouseDoubleClick"
                          Margin="0,5"
                          RowHeight="25">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                        <DataGridTextColumn Header="Windows логин" Binding="{Binding WindowsLogin}" Width="120"/>
                        <DataGridTextColumn Header="Полное имя" Binding="{Binding FullName}" Width="150"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="100"/>
                        <DataGridTextColumn Header="Роль" Binding="{Binding Role.Name}" Width="120"/>
                        <DataGridTextColumn Header="Отдел по умолч." Binding="{Binding DefaultDepartment.Name}" Width="120"/>
                        <DataGridCheckBoxColumn Header="Все отделы" Binding="{Binding HasAllDepartments}" Width="70"/>
                        <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Статус бар -->
                <StatusBar Grid.Row="2" Background="#FFF0F0F0">
                    <StatusBarItem>
                        <TextBlock x:Name="txtUsersStatus" Text="Готов"/>
                    </StatusBarItem>
                </StatusBar>
            </Grid>
        </TabItem>

        <!-- Вкладка Доступ к отделам и складам -->
        <TabItem Header="Доступ к отделам и складам">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Выбор пользователя -->
                <Border Grid.Row="0" Background="#FFF5F5F5" Padding="10" Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Пользователь:" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox Grid.Column="1" x:Name="cmbAccessUser" 
                                  Height="30" Margin="5,0"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="Id"
                                  SelectionChanged="CmbAccessUser_SelectionChanged"/>

                        <Button Grid.Column="3" x:Name="btnRefreshAccess" 
                                Content="Обновить" Width="80" Height="30" 
                                HorizontalAlignment="Right" Margin="5"
                                Click="BtnRefreshAccess_Click"/>
                    </Grid>
                </Border>

                <!-- Доступ к отделам и складам -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Отделы -->
                    <Border Grid.Column="0" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                                <TextBlock Text="Доступные отделы" FontWeight="Bold" FontSize="14"/>
                            </Border>

                            <ListBox x:Name="lbDepartments" Grid.Row="1" 
                                     DisplayMemberPath="Name"
                                     SelectionMode="Single"
                                     SelectionChanged="LbDepartments_SelectionChanged"
                                     Margin="0,5"/>

                            <Border Grid.Row="2" Background="#FFF5F5F5" Padding="5">
                                <StackPanel>
                                    <CheckBox x:Name="chkHasAllWarehouses" 
                                              Content="Доступ ко всем складам отдела"
                                              Margin="5"
                                              Checked="ChkHasAllWarehouses_Changed"
                                              Unchecked="ChkHasAllWarehouses_Changed"/>
                                    <Button x:Name="btnSaveDepartmentAccess" 
                                            Content="Сохранить доступ к отделу"
                                            Height="30" Margin="5"
                                            Click="BtnSaveDepartmentAccess_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Разделитель -->
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" 
                                  Background="#FFD0D0D0" Width="5"/>

                    <!-- Склады -->
                    <Border Grid.Column="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                                <TextBlock x:Name="txtWarehousesTitle" Text="Склады выбранного отдела" FontWeight="Bold" FontSize="14"/>
                            </Border>

                            <ListBox x:Name="lbWarehouses" Grid.Row="1" 
                                     DisplayMemberPath="Name"
                                     SelectionMode="Multiple"
                                     Margin="0,5"/>

                            <Border Grid.Row="2" Background="#FFF5F5F5" Padding="5">
                                <Button x:Name="btnSaveWarehouseAccess" 
                                        Content="Сохранить доступ к складам"
                                        Height="30" Margin="5"
                                        Click="BtnSaveWarehouseAccess_Click"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>