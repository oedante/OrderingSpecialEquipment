<Window x:Class="OrderingSpecialEquipment.Views.EquipmentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="900"
        Title="Справочник техники" 
        WindowStartupLocation="CenterOwner"
        Width="900" Height="600"
        MinWidth="800" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Style="{StaticResource ModernToolBar}">
            <Button x:Name="btnAdd" Content="➕ Добавить" 
                    Click="BtnAdd_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать" 
                    Click="BtnEdit_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Button x:Name="btnDelete" Content="🗑️ Удалить" 
                    Click="BtnDelete_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <Button x:Name="btnDependencies" Content="🔗 Зависимости" 
                    Click="BtnDependencies_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" 
                    Click="BtnRefresh_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <CheckBox x:Name="chkShowInactive" Content="Показывать неактивные" 
                      VerticalAlignment="Center" Margin="5,0" 
                      Checked="ChkShowInactive_Changed" 
                      Unchecked="ChkShowInactive_Changed"
                      Style="{StaticResource ModernCheckBox}"/>
        </ToolBar>

        <!-- Таблица техники -->
        <DataGrid x:Name="dgEquipments" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="DgEquipments_MouseDoubleClick"
                  Margin="0,5"
                  Style="{StaticResource ModernDataGrid}"
                  RowStyle="{StaticResource ModernDataGridRow}"
                  CellStyle="{StaticResource ModernDataGridCell}"
                  ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                  Background="{DynamicResource BackgroundBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource BackgroundBrush}"
                  AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="50"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="200"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridCheckBoxColumn Header="Несколько" Binding="{Binding CanOrderMultiple}" Width="70"
                                        CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Стоимость часа" Binding="{Binding HourlyCost, Converter={StaticResource CurrencyFormat}}" Width="120"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridCheckBoxColumn Header="Требует оператора" Binding="{Binding RequiresOperator}" Width="100"
                                        CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"
                                        CellStyle="{StaticResource ModernDataGridCell}"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"
                                    CellStyle="{StaticResource ModernDataGridCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования -->
        <Popup x:Name="EditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="500">
                <ScrollViewer MaxHeight="600" 
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel>
                        <TextBlock x:Name="PopupTitle" 
                                   Text="Добавление техники" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Наименование:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtName" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Категория:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtCategory" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Почасовая стоимость:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtHourlyCost" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <CheckBox x:Name="chkCanOrderMultiple" 
                                  Content="Можно заказать несколько единиц" 
                                  Margin="0,5"
                                  Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox x:Name="chkRequiresOperator" 
                                  Content="Требуется оператор" 
                                  Margin="0,5"
                                  Style="{StaticResource ModernCheckBox}"/>
                        <CheckBox x:Name="chkIsActive" 
                                  Content="Активен" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Style="{StaticResource ModernCheckBox}"/>

                        <TextBlock Text="Описание:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtDescription" 
                                 Height="80" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,20,0,0">
                            <Button x:Name="btnSave" 
                                    Content="Сохранить" 
                                    Width="100" 
                                    Height="35" 
                                    Margin="5" 
                                    Click="BtnSave_Click"
                                    Style="{StaticResource ModernButton}"/>
                            <Button x:Name="btnCancel" 
                                    Content="Отмена" 
                                    Width="100" 
                                    Height="35" 
                                    Margin="5" 
                                    Click="BtnCancel_Click"
                                    Style="{StaticResource ModernButton}"
                                    Background="#FF9E9E9E"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Popup для зависимостей -->
        <Popup x:Name="DependenciesPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="600" Height="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="DependenciesTitle" 
                               Text="Зависимости техники" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <DataGrid x:Name="dgDependencies" Grid.Row="1" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Зависимая техника" 
                                                Binding="{Binding DependentEquipment.Name}" 
                                                Width="*"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Количество" 
                                                Binding="{Binding RequiredCount}" 
                                                Width="80"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridCheckBoxColumn Header="Обязательная" 
                                                    Binding="{Binding IsMandatory}" 
                                                    Width="80"
                                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAddDependency" 
                                Content="Добавить" 
                                Width="80" 
                                Height="30" 
                                Margin="5" 
                                Click="BtnAddDependency_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnDeleteDependency" 
                                Content="Удалить" 
                                Width="80" 
                                Height="30" 
                                Margin="5" 
                                Click="BtnDeleteDependency_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCloseDependencies" 
                                Content="Закрыть" 
                                Width="80" 
                                Height="30" 
                                Margin="5" 
                                Click="BtnCloseDependencies_Click"
                                Style="{StaticResource ModernButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Popup для добавления зависимости -->
        <Popup x:Name="AddDependencyPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="400">
                <StackPanel>
                    <TextBlock Text="Добавление зависимости" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Зависимая техника:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="cmbDependentEquipment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" 
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernComboBox}"/>

                    <TextBlock Text="Количество:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtDependencyCount" 
                             Text="1" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <CheckBox x:Name="chkIsMandatory" 
                              Content="Обязательная" 
                              IsChecked="True" 
                              Margin="0,5"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSaveDependency" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSaveDependency_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancelDependency" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancelDependency_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>