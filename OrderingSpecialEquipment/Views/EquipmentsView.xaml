<Window x:Class="OrderingSpecialEquipment.Views.EquipmentsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="900"
        Title="Справочник техники" 
        WindowStartupLocation="CenterOwner"
        Width="900" Height="600"
        MinWidth="800" MinHeight="400">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Background="#FFF0F0F0" Height="40">
            <Button x:Name="btnAdd" Content="➕ Добавить" Click="BtnAdd_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnEdit" Content="✏️ Редактировать" Click="BtnEdit_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnDelete" Content="🗑️ Удалить" Click="BtnDelete_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnDependencies" Content="🔗 Зависимости" Click="BtnDependencies_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Click="BtnRefresh_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <CheckBox x:Name="chkShowInactive" Content="Показывать неактивные" 
                      VerticalAlignment="Center" Margin="5,0" Checked="ChkShowInactive_Changed" Unchecked="ChkShowInactive_Changed"/>
        </ToolBar>

        <!-- Таблица техники -->
        <DataGrid x:Name="dgEquipments" Grid.Row="1" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="DgEquipments_MouseDoubleClick"
                  Margin="0,5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Ключ" Binding="{Binding Key}" Width="50"/>
                <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                <DataGridCheckBoxColumn Header="Несколько" Binding="{Binding CanOrderMultiple}" Width="70"/>
                <DataGridTextColumn Header="Стоимость часа" Binding="{Binding HourlyCost, Converter={StaticResource CurrencyFormat}}" Width="120"/>
                <DataGridCheckBoxColumn Header="Требует оператора" Binding="{Binding RequiresOperator}" Width="100"/>
                <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Background="#FFF0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования -->
        <Popup x:Name="EditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=Self}}">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="500">
                <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="PopupTitle" Text="Добавление техники" 
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Наименование:" Margin="0,5"/>
                        <TextBox x:Name="txtName" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Категория:" Margin="0,5"/>
                        <TextBox x:Name="txtCategory" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Почасовая стоимость:" Margin="0,5"/>
                        <TextBox x:Name="txtHourlyCost" Height="30" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkCanOrderMultiple" Content="Можно заказать несколько единиц" Margin="0,5"/>
                        <CheckBox x:Name="chkRequiresOperator" Content="Требуется оператор" Margin="0,5"/>
                        <CheckBox x:Name="chkIsActive" Content="Активен" IsChecked="True" Margin="0,5"/>

                        <TextBlock Text="Описание:" Margin="0,5"/>
                        <TextBox x:Name="txtDescription" Height="80" TextWrapping="Wrap" 
                                 AcceptsReturn="True" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" 
                                    Margin="5" Click="BtnSave_Click"/>
                            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                                    Margin="5" Click="BtnCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Popup для зависимостей -->
        <Popup x:Name="DependenciesPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="600" Height="500">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="DependenciesTitle" 
                               Text="Зависимости техники" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <DataGrid x:Name="dgDependencies" Grid.Row="1" 
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Зависимая техника" Binding="{Binding DependentEquipment.Name}" Width="*"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding RequiredCount}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Обязательная" Binding="{Binding IsMandatory}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnAddDependency" Content="Добавить" Width="80" Height="30" 
                                Margin="5" Click="BtnAddDependency_Click"/>
                        <Button x:Name="btnDeleteDependency" Content="Удалить" Width="80" Height="30" 
                                Margin="5" Click="BtnDeleteDependency_Click"/>
                        <Button x:Name="btnCloseDependencies" Content="Закрыть" Width="80" Height="30" 
                                Margin="5" Click="BtnCloseDependencies_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- Popup для добавления зависимости -->
        <Popup x:Name="AddDependencyPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="400">
                <StackPanel>
                    <TextBlock Text="Добавление зависимости" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Зависимая техника:" Margin="0,5"/>
                    <ComboBox x:Name="cmbDependentEquipment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Количество:" Margin="0,5"/>
                    <TextBox x:Name="txtDependencyCount" Text="1" Height="30" Margin="0,0,0,10"/>

                    <CheckBox x:Name="chkIsMandatory" Content="Обязательная" IsChecked="True" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnSaveDependency" Content="Сохранить" Width="100" Height="35" 
                                Margin="5" Click="BtnSaveDependency_Click"/>
                        <Button x:Name="btnCancelDependency" Content="Отмена" Width="100" Height="35" 
                                Margin="5" Click="BtnCancelDependency_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>