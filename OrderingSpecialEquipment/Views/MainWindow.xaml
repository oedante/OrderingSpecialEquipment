 <Window x:Class="OrderingSpecialEquipment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:OrderingSpecialEquipment.ViewModels"
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:controls="clr-namespace:OrderingSpecialEquipment.Controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="800" d:DesignWidth="1200"
        Title="{Binding WindowTitle}" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:ShiftToTextConverter x:Key="ShiftToText"/>
        <converters:DayOfWeekConverter x:Key="DayOfWeekConverter"/>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToString"/>

        <!-- Анимации -->
        <Storyboard x:Key="ShowPanelAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width" 
                             To="250" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HidePanelAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width" 
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeInPopup">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutPopup">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" 
              Style="{StaticResource ModernMenu}"
              Background="{DynamicResource MenuBackgroundBrush}"
              Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="Файл" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Настройки подключения" 
                          Command="{Binding OpenConnectionSettingsCommand}"
                          Style="{StaticResource ModernMenuItem}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <MenuItem Header="Выход" Click="MenuItemExit_Click" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Справочники" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Отделы" Command="{Binding OpenDepartmentsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Техника" Command="{Binding OpenEquipmentsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Склады и территории" Command="{Binding OpenWarehousesCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Арендодатели и госномера" Command="{Binding OpenLessorsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Транспортная программа" Command="{Binding OpenTransportProgramCommand}" Style="{StaticResource ModernMenuItem}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <MenuItem Header="Пользователи и права" Command="{Binding OpenUsersCommand}" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Отчеты" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Выполнение транспортной программы" Command="{Binding OpenTransportReportCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Детализация заявок" Command="{Binding OpenShiftReportCommand}" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Настройки" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Только избранное" IsCheckable="True" 
                          IsChecked="{Binding IsOnlyFavorites}"
                          Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Темная тема" IsCheckable="True" 
                          IsChecked="{Binding IsDarkTheme}"
                          Command="{Binding ToggleThemeCommand}"
                          Style="{StaticResource ModernMenuItem}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <MenuItem Header="Настройки пользователя" 
                          Command="{Binding OpenUserSettingsCommand}"
                          Style="{StaticResource ModernMenuItem}">
                    <MenuItem.Icon>
                        <materialDesign:PackIcon Kind="Cog" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Помощь" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="О программе" Click="MenuItemAbout_Click" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="1" Style="{StaticResource ModernToolBar}" Height="Auto">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding PreviousDayCommand}" 
                        ToolTip="Предыдущий день" 
                        Width="32" Height="32"
                        Margin="2"
                        Style="{StaticResource IconButton}">
                    <materialDesign:PackIcon Kind="ArrowLeft" Style="{StaticResource AppPackIcon}"/>
                </Button>

                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" 
                            Width="140" 
                            Height="32"
                            Margin="2"
                            Style="{StaticResource ModernDatePicker}"/>

                <Button Command="{Binding NextDayCommand}" 
                        ToolTip="Следующий день" 
                        Width="32" Height="32"
                        Margin="2"
                        Style="{StaticResource IconButton}">
                    <materialDesign:PackIcon Kind="ArrowRight" Style="{StaticResource AppPackIcon}"/>
                </Button>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                        CornerRadius="4" 
                        Padding="2,4" 
                        Margin="2,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Width="140">
                        <TextBlock Text="{Binding DisplayDate}" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="(" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding DisplayDayOfWeek}" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text=")" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource TextBrush}"/>
                <ComboBox ItemsSource="{Binding AccessibleDepartments}"
                          SelectedItem="{Binding SelectedDepartment}"
                          DisplayMemberPath="Name"
                          Width="200" 
                          Height="32" 
                          Margin="5,0"
                          Style="{StaticResource ModernComboBox}"/>
            </StackPanel>

        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Левая панель с техникой - Column 0 -->
                <ColumnDefinition x:Name="LeftPanelColumn" 
                                  Width="{Binding LeftPanelWidth}" 
                                  MinWidth="0" 
                                  MaxWidth="400"/>
                <ColumnDefinition Width="5"/>
                <!-- Правая таблица заявок - Column 2 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель с техникой -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="10" 
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Техника" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Margin="0,0,5,0"
                                           Foreground="{DynamicResource TextBrush}"/>

                                <TextBlock Text="{Binding SelectedDepartment.Name}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextLightBrush}"/>

                                <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,5,0"/>

                                <!-- Чекбокс "Только избранное" -->
                                <CheckBox IsChecked="{Binding IsOnlyFavorites}"
                                          VerticalAlignment="Center"
                                          Margin="10,0,5,0"
                                          ToolTip="Отображать только избранное"
                                          Style="{StaticResource ModernCheckBox}">
                                    <materialDesign:PackIcon Kind="StarOutline" Style="{StaticResource AppPackIcon}"/>
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Список техники с кнопками для добавления в смены -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding EquipmentItems}"
                             SelectedItem="{Binding SelectedEquipment}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource ModernListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding HoursLeftColor}"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,2"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Звездочка избранного (Row 0) -->
                                        <materialDesign:PackIcon Grid.Row="0" Grid.Column="0"
                                                               Style="{StaticResource FavoritePackIconStyle}"
                                                               Tag="{Binding}"
                                                               MouseLeftButtonUp="FavoriteStar_MouseLeftButtonUp"
                                                               VerticalAlignment="Center"/>

                                        <!-- Название техники (Row 0) -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" 
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   Margin="8,0,4,0"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <!-- Оставшиеся часы (Row 0) -->
                                        <Border Grid.Row="0" Grid.Column="2"
                                                Background="{DynamicResource HeaderBackgroundBrush}"
                                                CornerRadius="3"
                                                Padding="4,2"
                                                Margin="4,0"
                                                ToolTip="Осталось часов по транспортной программе">
                                            <TextBlock Text="{Binding HoursLeftDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextLightBrush}"/>
                                        </Border>

                                        <!-- Количество заявок (Row 0) -->
                                        <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Border Background="#FFE3F2FD" 
                                                    CornerRadius="3" 
                                                    Padding="4,2" 
                                                    Margin="2,0"
                                                    ToolTip="Ночная смена">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherNight" Foreground="#FF1976D2" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding NightCount}" FontSize="11" Foreground="#FF1976D2"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#FFF3E5F5" 
                                                    CornerRadius="3" 
                                                    Padding="4,2" 
                                                    Margin="2,0"
                                                    ToolTip="Дневная смена">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherSunny" Foreground="#FF7B1FA2" Width="14" Height="14" Margin="0,0,4,0"/>
                                                    <TextBlock Text="{Binding DayCount}" FontSize="11" Foreground="#FF7B1FA2"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Кнопки для добавления в смены (Row 1) -->
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" 
                                                    Orientation="Horizontal" 
                                                    HorizontalAlignment="Right"
                                                    Margin="0,5,0,0">
                                            <Button Command="{Binding DataContext.AddNightShiftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Height="24"
                                                    FontSize="10"
                                                    Padding="6,2"
                                                    Margin="2"
                                                    Background="#FF1976D2"
                                                    Style="{StaticResource ModernButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherNight" Foreground="White" Width="14" Height="14" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Ночь" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding DataContext.AddDayShiftCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Height="24"
                                                    FontSize="10"
                                                    Padding="6,2"
                                                    Margin="2"
                                                    Background="#FF7B1FA2"
                                                    Style="{StaticResource ModernButton}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="WeatherSunny" Foreground="White" Width="14" Height="14" Margin="0,0,6,0"/>
                                                    <TextBlock Text="День" Foreground="White" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}" 
                          Width="5"
                          Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Центральная таблица заявок -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource BackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов таблицы -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="10" 
                            CornerRadius="4,4,0,0">
                        <StackPanel Orientation="Horizontal">

                            <!-- Кнопка скрытия/показа панели -->
                            <Button x:Name="TogglePanelButton"
                                    Command="{Binding ToggleLeftPanelCommand}"
                                    ToolTip="{Binding LeftPanelButtonToolTip}"
                                    Width="34" 
                                    Height="34" 
                                    Margin="0,0,10,0"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Style="{StaticResource IconButton}">
                                <TextBlock Text="{Binding LeftPanelButtonText}" FontSize="14" Foreground="White"/>
                            </Button>

                            <Button Command="{Binding AddRequestCommand}"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource ModernButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Добавить заявку"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ExportToExcelCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource ModernButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileExcel" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Экспорт в Excel"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Таблица заявок с группировкой -->
                    <DataGrid Grid.Row="1"
                              x:Name="RequestsDataGrid"
                              ItemsSource="{Binding GroupedShiftRequests}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">

                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource PopupBackgroundBrush}" 
                                        BorderBrush="{DynamicResource PopupBorderBrush}">
                                <MenuItem Header="Редактировать" 
                                          Command="{Binding PlacementTarget.DataContext.EditRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Style="{StaticResource ModernMenuItem}"/>
                                <MenuItem Header="Удалить" 
                                          Command="{Binding PlacementTarget.DataContext.DeleteRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Style="{StaticResource ModernMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                                Padding="10,4"
                                                CornerRadius="3"
                                                Margin="0,2"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" 
                                                Binding="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                                Width="90"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Смена" 
                                                Binding="{Binding ShiftName}" 
                                                Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Отдел" 
                                                Binding="{Binding DepartmentName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Склад" 
                                                Binding="{Binding WarehouseName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Территория" 
                                                Binding="{Binding AreaName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Техника" 
                                                Binding="{Binding EquipmentName}" 
                                                Width="150"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Госномер" 
                                                Binding="{Binding PlateNumber}" 
                                                Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Арендодатель" 
                                                Binding="{Binding LessorName}" 
                                                Width="150"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Кол-во" 
                                                Binding="{Binding RequestedCount}" 
                                                Width="50"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Часы" 
                                                Binding="{Binding WorkedHours}" 
                                                Width="60"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Отработано" 
                                                Binding="{Binding IsWorked, Converter={StaticResource BoolToYesNo}}" 
                                                Width="80"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Создал" 
                                                Binding="{Binding CreatedByUser}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTemplateColumn Header=" " Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFD700"
                                                CornerRadius="3"
                                                Padding="2"
                                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Запись редактируется другим пользователем">
                                            <materialDesign:PackIcon Kind="Lock" Width="12" Height="12" Foreground="#FF000000"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пользователь: " Foreground="{DynamicResource TextLightBrush}"/>
                    <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Роль: " Foreground="{DynamicResource TextLightBrush}"/>
                    <TextBlock Text="{Binding CurrentUser.Role.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextLightBrush}"/>
            </StatusBarItem>

            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Подключение:" Foreground="{DynamicResource TextLightBrush}" Margin="5,0"/>
                    <Ellipse Width="12" Height="12" Margin="2,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToStatusTextConverter}}" 
                               Foreground="{DynamicResource TextLightBrush}" Margin="2,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>