<Window x:Class="OrderingSpecialEquipment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:OrderingSpecialEquipment.ViewModels"
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:controls="clr-namespace:OrderingSpecialEquipment.Controls"
        mc:Ignorable="d" 
        d:DesignHeight="800" d:DesignWidth="1200"
        Title="{Binding WindowTitle}" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:ShiftToTextConverter x:Key="ShiftToText"/>
        <converters:DayOfWeekConverter x:Key="DayOfWeekConverter"/>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <converters:CurrencyFormatConverter x:Key="CurrencyFormat"/>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVis"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToString"/>

        <!-- Анимации -->
        <Storyboard x:Key="ShowPanelAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width" 
                             To="250" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HidePanelAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Width" 
                             To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="FadeInPopup">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutPopup">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" 
              Style="{StaticResource ModernMenu}"
              Background="{DynamicResource MenuBackgroundBrush}"
              Foreground="{DynamicResource TextBrush}">
            <MenuItem Header="Файл" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Настройки подключения" 
                          Command="{Binding OpenConnectionSettingsCommand}"
                          Style="{StaticResource ModernMenuItem}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <MenuItem Header="Выход" Click="MenuItemExit_Click" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Справочники" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Отделы" Command="{Binding OpenDepartmentsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Техника" Command="{Binding OpenEquipmentsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Склады и территории" Command="{Binding OpenWarehousesCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Арендодатели и госномера" Command="{Binding OpenLessorsCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Транспортная программа" Command="{Binding OpenTransportProgramCommand}" Style="{StaticResource ModernMenuItem}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <MenuItem Header="Пользователи и права" Command="{Binding OpenUsersCommand}" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Отчеты" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Выполнение транспортной программы" Command="{Binding OpenTransportReportCommand}" Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Детализация заявок" Command="{Binding OpenShiftReportCommand}" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Настройки" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="Только избранное" IsCheckable="True" 
                          IsChecked="{Binding IsOnlyFavorites}"
                          Style="{StaticResource ModernMenuItem}"/>
                <MenuItem Header="Темная тема" IsCheckable="True" 
                          IsChecked="{Binding IsDarkTheme}"
                          Command="{Binding ToggleThemeCommand}"
                          Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>

            <MenuItem Header="Помощь" Style="{StaticResource ModernMenuItem}">
                <MenuItem Header="О программе" Click="MenuItemAbout_Click" Style="{StaticResource ModernMenuItem}"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="1" Style="{StaticResource ModernToolBar}">
            <StackPanel Orientation="Horizontal">
                <Button Content="←" 
                        Command="{Binding PreviousDayCommand}" 
                        ToolTip="Предыдущий день" 
                        Width="32" Height="32"
                        Margin="2"
                        Style="{StaticResource IconButton}"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" 
                            Width="140" 
                            Height="32"
                            Margin="2"
                            Style="{StaticResource ModernDatePicker}"/>
                <Button Content="→" 
                        Command="{Binding NextDayCommand}" 
                        ToolTip="Следующий день" 
                        Width="32" Height="32"
                        Margin="2"
                        Style="{StaticResource IconButton}"/>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <Border Background="{DynamicResource HeaderBackgroundBrush}" 
                        CornerRadius="4" 
                        Padding="8,4" 
                        Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayDate}" FontWeight="SemiBold" Margin="0,0,4,0" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="(" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="{Binding DisplayDayOfWeek}" Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text=")" Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Separator Style="{StaticResource ModernSeparator}"/>

                <TextBlock Text="Отдел:" VerticalAlignment="Center" Margin="5,0" Foreground="{DynamicResource TextBrush}"/>
                <ComboBox ItemsSource="{Binding AccessibleDepartments}"
                          SelectedItem="{Binding SelectedDepartment}"
                          DisplayMemberPath="Name"
                          Width="200" 
                          Height="32" 
                          Margin="5,0"
                          Style="{StaticResource ModernComboBox}"/>
            </StackPanel>

        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <!-- Левая панель с техникой - Column 0 -->
                <ColumnDefinition x:Name="LeftPanelColumn" 
                                  Width="{Binding LeftPanelWidth}" 
                                  MinWidth="0" 
                                  MaxWidth="400"/>
                <ColumnDefinition Width="5"/>
                <!-- Правая таблица заявок - Column 2 -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель с техникой -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4"
                    Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="10" 
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Техника" 
                                           FontSize="16" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding SelectedDepartment.Name}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextLightBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Список техники -->
                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding EquipmentItems}"
                             SelectedItem="{Binding SelectedEquipment}"
                             Background="Transparent"
                             BorderThickness="0"
                             Margin="5"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource ModernListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding HoursLeftColor}"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,2"
                                        MouseLeftButtonUp="FavoriteStar_MouseLeftButtonUp"
                                        Tag="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Звездочка избранного -->
                                        <TextBlock Grid.Column="0" 
                                                   Style="{StaticResource FavoriteStarStyle}"
                                                   Tag="{Binding}"
                                                   VerticalAlignment="Center"/>

                                        <!-- Название техники -->
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding DisplayName}"
                                                   TextWrapping="Wrap"
                                                   Margin="8,0,4,0"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"/>

                                        <!-- Оставшиеся часы -->
                                        <Border Grid.Column="2"
                                                Background="{DynamicResource HeaderBackgroundBrush}"
                                                CornerRadius="3"
                                                Padding="4,2"
                                                Margin="4,0"
                                                ToolTip="Осталось часов по транспортной программе">
                                            <TextBlock Text="{Binding HoursLeftDisplay}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextLightBrush}"/>
                                        </Border>

                                        <!-- Количество заявок -->
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="4,0,0,0">
                                            <Border Background="#FFE3F2FD" 
                                                    CornerRadius="3" 
                                                    Padding="4,2" 
                                                    Margin="2,0"
                                                    ToolTip="Ночная смена">
                                                <TextBlock Text="{Binding NightCount}" 
                                                           FontSize="11" 
                                                           Foreground="#FF1976D2"/>
                                            </Border>
                                            <Border Background="#FFF3E5F5" 
                                                    CornerRadius="3" 
                                                    Padding="4,2" 
                                                    Margin="2,0"
                                                    ToolTip="Дневная смена">
                                                <TextBlock Text="{Binding DayCount}" 
                                                           FontSize="11" 
                                                           Foreground="#FF7B1FA2"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}" 
                          Width="5"
                          Visibility="{Binding IsLeftPanelVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- Центральная таблица заявок -->
            <Border Grid.Column="2" 
                    Background="{DynamicResource BackgroundBrush}" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов таблицы -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="10" 
                            CornerRadius="4,4,0,0">
                        <StackPanel Orientation="Horizontal">

                            <!-- Кнопка скрытия/показа панели (всегда видима) -->
                            <Button Grid.Column="0"
                                    x:Name="TogglePanelButton"
                                    Content="{Binding LeftPanelButtonText}"
                                    Command="{Binding ToggleLeftPanelCommand}"
                                    ToolTip="{Binding LeftPanelButtonToolTip}"
                                    Width="34" 
                                    Height="34" 
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,0,10,0"
                                    Panel.ZIndex="10"
                                    Background="{DynamicResource PrimaryBrush}"
                                    BorderThickness="0"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Style="{StaticResource IconButton}"/>

                            <Button Content="➕ Добавить заявку"
                                    Command="{Binding AddRequestCommand}"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource ModernButton}"/>
                            
                            <Button Content="📊 Экспорт в Excel"
                                    Command="{Binding ExportToExcelCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource ModernButton}"/>

                            <Separator Style="{StaticResource ModernSeparator}"/>

                            <CheckBox IsChecked="{Binding IsOnlyFavorites}"
                                      Content="Только избранное"
                                      VerticalAlignment="Center"
                                      Margin="5,0"
                                      Style="{StaticResource ModernCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <!-- Таблица заявок с группировкой -->
                    <DataGrid Grid.Row="1"
                              x:Name="RequestsDataGrid"
                              ItemsSource="{Binding GroupedShiftRequests}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">

                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{DynamicResource PopupBackgroundBrush}" 
                                        BorderBrush="{DynamicResource PopupBorderBrush}">
                                <MenuItem Header="Редактировать" 
                                          Command="{Binding PlacementTarget.DataContext.EditRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Style="{StaticResource ModernMenuItem}"/>
                                <MenuItem Header="Удалить" 
                                          Command="{Binding PlacementTarget.DataContext.DeleteRequestCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Style="{StaticResource ModernMenuItem}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource HeaderBackgroundBrush}"
                                                Padding="10,4"
                                                CornerRadius="3"
                                                Margin="0,2"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" 
                                                Binding="{Binding Date, StringFormat=dd.MM.yyyy}" 
                                                Width="90"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Смена" 
                                                Binding="{Binding ShiftName}" 
                                                Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Отдел" 
                                                Binding="{Binding DepartmentName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Склад" 
                                                Binding="{Binding WarehouseName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Территория" 
                                                Binding="{Binding AreaName}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Техника" 
                                                Binding="{Binding EquipmentName}" 
                                                Width="150"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Госномер" 
                                                Binding="{Binding PlateNumber}" 
                                                Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Арендодатель" 
                                                Binding="{Binding LessorName}" 
                                                Width="150"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Кол-во" 
                                                Binding="{Binding RequestedCount}" 
                                                Width="50"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Часы" 
                                                Binding="{Binding WorkedHours}" 
                                                Width="60"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Отработано" 
                                                Binding="{Binding IsWorked, Converter={StaticResource BoolToYesNo}}" 
                                                Width="80"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Создал" 
                                                Binding="{Binding CreatedByUser}" 
                                                Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTemplateColumn Header=" " Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFFFD700"
                                                CornerRadius="3"
                                                Padding="2"
                                                Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Запись редактируется другим пользователем">
                                            <TextBlock Text="🔒" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пользователь: " Foreground="{DynamicResource TextLightBrush}"/>
                    <TextBlock Text="{Binding CurrentUser.FullName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Роль: " Foreground="{DynamicResource TextLightBrush}"/>
                    <TextBlock Text="{Binding CurrentUser.Role.Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextLightBrush}"/>
            </StatusBarItem>

            <Separator Style="{StaticResource ModernSeparator}"/>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Подключение:" Foreground="{DynamicResource TextLightBrush}" Margin="5,0"/>
                    <Ellipse Width="12" Height="12" Margin="2,0">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToColorConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToStatusTextConverter}}" 
                               Foreground="{DynamicResource TextLightBrush}" Margin="2,0"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Индикатор загрузки -->
        <Border Grid.RowSpan="4"
                Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Загрузка данных..." 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}"
                           Margin="0,0,0,20"/>
                <ProgressBar IsIndeterminate="True" 
                             Height="4" 
                             Width="300"
                             Style="{StaticResource ModernProgressBar}"/>
            </StackPanel>
        </Border>

        <!-- Всплывающее окно для добавления/редактирования заявки -->
        <Popup x:Name="EditPopup"
               IsOpen="{Binding IsPopupOpen}"
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}"
                    Width="700"
                    MaxHeight="800">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0"
                               Text="{Binding EditingRequest.IsNew, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Новая заявка;Редактирование заявки'}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,20"/>

                    <!-- Форма редактирования -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="600"
                                  Style="{StaticResource ModernScrollViewer}">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Основная информация -->
                            <GroupBox Header="Основная информация" 
                                      Style="{StaticResource ModernGroupBox}"
                                      Foreground="{DynamicResource TextBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Дата -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="Дата:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <DatePicker Grid.Row="0" Grid.Column="1" 
                                                SelectedDate="{Binding EditingRequest.Date}"
                                                Height="32"
                                                Margin="5"
                                                Style="{StaticResource ModernDatePicker}"/>

                                    <!-- Смена -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="Смена:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              SelectedValue="{Binding EditingRequest.Shift}"
                                              SelectedValuePath="Tag"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="Дневная" Tag="0" Style="{StaticResource ModernComboBoxItem}"/>
                                        <ComboBoxItem Content="Ночная" Tag="1" Style="{StaticResource ModernComboBoxItem}"/>
                                    </ComboBox>

                                    <!-- Отдел -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="Отдел:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1"
                                              ItemsSource="{Binding AccessibleDepartments}"
                                              SelectedItem="{Binding EditingRequest.Department}"
                                              DisplayMemberPath="Name"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- Склад -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" 
                                               Text="Склад:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1"
                                              ItemsSource="{Binding EditingRequest.AvailableWarehouses}"
                                              SelectedItem="{Binding EditingRequest.Warehouse}"
                                              DisplayMemberPath="Name"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- Территория -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" 
                                               Text="Территория:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1"
                                              ItemsSource="{Binding EditingRequest.AvailableAreas}"
                                              SelectedItem="{Binding EditingRequest.Area}"
                                              DisplayMemberPath="Name"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- Техника -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" 
                                               Text="Техника:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="5" Grid.Column="1"
                                              ItemsSource="{Binding AvailableEquipmentsForDepartment}"
                                              SelectedItem="{Binding EditingRequest.Equipment}"
                                              DisplayMemberPath="Name"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}"/>
                                </Grid>
                            </GroupBox>

                            <!-- Детали заказа -->
                            <GroupBox Header="Детали заказа" 
                                      Style="{StaticResource ModernGroupBox}"
                                      Foreground="{DynamicResource TextBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Количество -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="Количество:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <controls:NumericTextBox Grid.Row="0" Grid.Column="1"
                                                              Value="{Binding EditingRequest.RequestedCount}"
                                                              MinValue="1"
                                                              ControlIsEnabled="{Binding EditingRequest.CanOrderMultiple}"
                                                              Height="32"
                                                              Margin="5"/>

                                    <!-- Арендодатель -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="Арендодатель:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1"
                                              ItemsSource="{Binding AllLessorOrganizations}"
                                              SelectedItem="{Binding EditingRequest.LessorOrganization}"
                                              DisplayMemberPath="Name"
                                              Height="32"
                                              Margin="5"
                                              Style="{StaticResource ModernComboBox}"/>

                                    <!-- Госномер -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" 
                                               Text="Госномер:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <controls:SearchableComboBox Grid.Row="2" Grid.Column="1"
                                                                  ItemsSource="{Binding AllLicensePlates}"
                                                                  SelectedItem="{Binding EditingRequest.LicensePlate}"
                                                                  FilterByOrganization="{Binding EditingRequest.LessorOrganizationId}"
                                                                  FilterByEquipment="{Binding EditingRequest.EquipmentId}"
                                                                  DisplayMemberPath="PlateDisplay"
                                                                  Height="32"
                                                                  Margin="5"/>
                                </Grid>
                            </GroupBox>

                            <!-- Время работы -->
                            <GroupBox Header="Время работы" 
                                      Style="{StaticResource ModernGroupBox}"
                                      Foreground="{DynamicResource TextBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Время начала -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" 
                                               Text="Начало:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <controls:TimePicker Grid.Row="0" Grid.Column="1"
                                                         Value="{Binding StartTime}"
                                                         Height="32"
                                                         Margin="5"/>

                                    <!-- Время окончания -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" 
                                               Text="Окончание:" 
                                               VerticalAlignment="Center" 
                                               Margin="5"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <controls:TimePicker Grid.Row="1" Grid.Column="1"
                                                         Value="{Binding EndTime}"
                                                         Height="32"
                                                         Margin="5"/>

                                    <!-- Чекбокс обеда -->
                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                              Content="Вычесть 1 час на обед (если более 5 часов)"
                                              IsChecked="{Binding HasLunchBreak}"
                                              Margin="5"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ModernCheckBox}"/>

                                    <!-- Итоговые часы -->
                                    <Border Grid.Row="2" Grid.Column="2"
                                            Background="{DynamicResource HeaderBackgroundBrush}"
                                            CornerRadius="4"
                                            Padding="10,5"
                                            Margin="10,5,5,5"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <TextBlock Text="{Binding EditingRequest.WorkedHours, StringFormat='Итого: {0:F1} ч'}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"/>
                                    </Border>
                                </Grid>
                            </GroupBox>

                            <!-- Статусы -->
                            <GroupBox Header="Статус" 
                                      Style="{StaticResource ModernGroupBox}"
                                      Foreground="{DynamicResource TextBrush}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" 
                                                  Content="Отработано"
                                                  IsChecked="{Binding EditingRequest.IsWorked}"
                                                  Margin="5"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox Grid.Column="1" 
                                                  Content="Не предоставлена"
                                                  IsChecked="{Binding EditingRequest.IsNotProvided}"
                                                  Margin="5"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                        <CheckBox Grid.Column="2" 
                                                  Content="Актировка"
                                                  IsChecked="{Binding EditingRequest.IsWeatherCancellation}"
                                                  Margin="5"
                                                  Style="{StaticResource ModernCheckBox}"/>
                                    </Grid>

                                    <TextBox Text="{Binding EditingRequest.CancellationReason}"
                                             Height="32"
                                             Margin="5,10,5,5"
                                             Visibility="{Binding EditingRequest.IsNotProvided, Converter={StaticResource BoolToVis}}"
                                             Style="{StaticResource ModernTextBox}"
                                             ToolTip="Причина не предоставления..."/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Комментарий -->
                            <GroupBox Header="Комментарий" 
                                      Style="{StaticResource ModernGroupBox}"
                                      Foreground="{DynamicResource TextBrush}">
                                <TextBox Text="{Binding EditingRequest.Comment}"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         Margin="5"
                                         Style="{StaticResource ModernTextBox}"/>
                            </GroupBox>

                            <!-- Информация о блокировке -->
                            <Border Background="#FFFFE0E0"
                                    CornerRadius="4"
                                    Padding="10"
                                    Visibility="{Binding EditingRequest.IsBlocked, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1">
                                <TextBlock Text="Запись заблокирована другим пользователем"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Сохранить"
                                Command="{Binding SaveRequestCommand}"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Style="{StaticResource ModernButton}"/>
                        <Button Content="Отмена"
                                Command="{Binding CancelEditCommand}"
                                Background="#FF9E9E9E"
                                Width="100"
                                Height="35"
                                Margin="5"
                                Style="{StaticResource ModernButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>