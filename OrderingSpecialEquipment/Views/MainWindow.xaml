<Window x:Class="OrderingSpecialEquipment.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:OrderingSpecialEquipment.ViewModels"
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d" 
        d:DesignHeight="800" d:DesignWidth="1200"
        Title="{Binding WindowTitle}" 
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Конвертеры -->
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBooleanConverter x:Key="InverseBool"/>
        <converters:ShiftToTextConverter x:Key="ShiftToText"/>
        <converters:RequestStatusToBrushConverter x:Key="StatusToBrush"/>
        <converters:BooleanToOpacityConverter x:Key="BoolToOpacity"/>
        <converters:DayOfWeekConverter x:Key="DayOfWeekConverter"/>
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <converters:BooleanToYesNoConverter x:Key="BooleanToYesNoConverter"/>
        <converters:BooleanToStatusTextConverter x:Key="BooleanToStatusTextConverter"/>
        <converters:BooleanToTextConverter x:Key="BooleanToTextConverter"/>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>

        <!-- Стили -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoriteStarStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="Gold"/>
            <Setter Property="Text" Value="☆"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Text" Value="★"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RequestRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{Binding Converter={StaticResource StatusToBrush}}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Шаблон для группировки -->
        <HierarchicalDataTemplate x:Key="GroupTemplate" DataType="CollectionViewGroup">
            <Border Background="#FFF0F0F0" Padding="5" Margin="0,2,0,2" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="5,0"/>
                    <TextBlock Text=" (" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ItemCount}" FontWeight="Bold"/>
                    <TextBlock Text=")" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Меню -->
        <Menu Grid.Row="0" Background="#FFE0E0E0">
            <MenuItem Header="_Файл">
                <MenuItem Header="Настройки подключения" 
                          Command="{Binding OpenConnectionSettingsCommand}"
                          Visibility="{Binding CanOpenConnectionSettings, Converter={StaticResource BoolToVis}}"/>
                <Separator/>
                <MenuItem Header="Выход" Click="MenuItemExit_Click"/>
            </MenuItem>

            <MenuItem Header="_Справочники">
                <MenuItem Header="Отделы" Command="{Binding OpenDepartmentsCommand}"/>
                <MenuItem Header="Техника" Command="{Binding OpenEquipmentsCommand}"/>
                <MenuItem Header="Склады и территории" Command="{Binding OpenWarehousesCommand}"/>
                <MenuItem Header="Арендодатели и госномера" Command="{Binding OpenLessorsCommand}"/>
                <MenuItem Header="Транспортная программа" Command="{Binding OpenTransportProgramCommand}"/>
                <Separator/>
                <MenuItem Header="Пользователи и права" Command="{Binding OpenUsersCommand}"/>
            </MenuItem>

            <MenuItem Header="_Отчеты">
                <MenuItem Header="Выполнение транспортной программы" Command="{Binding OpenTransportReportCommand}"/>
                <MenuItem Header="Детализация заявок" Command="{Binding OpenShiftReportCommand}"/>
            </MenuItem>

            <MenuItem Header="_Настройки">
                <MenuItem Header="Только избранное" IsCheckable="True" 
                          IsChecked="{Binding IsOnlyFavorites}"/>
            </MenuItem>

            <MenuItem Header="_Помощь">
                <MenuItem Header="О программе" Click="MenuItemAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель инструментов с календарем -->
        <ToolBar Grid.Row="1" Background="#FFF5F5F5" Height="40">
            <StackPanel Orientation="Horizontal" Margin="5,0">
                <Button Content="←" Width="30" Command="{Binding PreviousDayCommand}" ToolTip="Предыдущий день"/>
                <DatePicker SelectedDate="{Binding SelectedDate}" Width="120" Margin="2,0"/>
                <Button Content="→" Width="30" Command="{Binding NextDayCommand}" ToolTip="Следующий день"/>

                <Separator Margin="10,0"/>

                <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="5,0"/>
                <TextBlock Text="{Binding SelectedDate, StringFormat=dd.MM.yyyy}" 
                           FontWeight="Bold" VerticalAlignment="Center" Margin="2,0"/>
                <TextBlock Text="(" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedDate, Converter={StaticResource DayOfWeekConverter}}" 
                           VerticalAlignment="Center"/>
                <TextBlock Text=")" VerticalAlignment="Center"/>
            </StackPanel>
        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="400"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель с техникой -->
            <Border Grid.Column="0" Background="#FFF8F8F8" BorderBrush="#FFD0D0D0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок панели -->
                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Техника" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>

                            <CheckBox Grid.Column="1" Content="Только избранное" 
                                      IsChecked="{Binding IsOnlyFavorites}" 
                                      VerticalAlignment="Center" Margin="10,0,0,0"/>

                            <Button Grid.Column="2" Content="◀" Width="25" Height="25" 
                                    Command="{Binding ToggleLeftPanelCommand}"
                                    ToolTip="Скрыть панель"/>
                        </Grid>
                    </Border>

                    <!-- Список техники -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding EquipmentItems}" 
                             SelectedItem="{Binding SelectedEquipment}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="3" Margin="1">
                                    <Border.Background>
                                        <MultiBinding Converter="{StaticResource BoolToOpacity}">
                                            <Binding Path="IsFavorite"/>
                                            <Binding Source="1.0"/>
                                            <Binding Source="0.7"/>
                                        </MultiBinding>
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Звездочка избранного -->
                                        <TextBlock Grid.Column="0" 
                                                   Style="{StaticResource FavoriteStarStyle}"
                                                   MouseLeftButtonUp="FavoriteStar_MouseLeftButtonUp"
                                                   Tag="{Binding}"/>

                                        <!-- Название техники -->
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" 
                                                   Margin="5,0" TextWrapping="Wrap"/>

                                        <!-- Количество заявок -->
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayCounts}" 
                                                   Foreground="#FF808080" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Разделитель с анимацией -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" 
                          Background="#FFD0D0D0" Width="5"/>

            <!-- Центральная таблица заявок -->
            <Border Grid.Column="2" Background="White" BorderBrush="#FFD0D0D0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель инструментов таблицы -->
                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="➕ Добавить" Command="{Binding AddRequestCommand}" 
                                    Margin="2" Padding="8,3"/>
                            <Button Content="📊 Экспорт в Excel" Command="{Binding ExportToExcelCommand}" 
                                    Margin="2" Padding="8,3"/>

                            <Separator Margin="10,0"/>

                            <TextBlock Text="Статус БД:" VerticalAlignment="Center" Margin="5,0"/>
                            <Ellipse Width="12" Height="12" Margin="2,0">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToColorConverter}}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </StackPanel>
                    </Border>

                    <!-- Таблица заявок с группировкой -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding ShiftRequests}"
         SelectedItem="{Binding SelectedRequest}"
         Background="Transparent" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#FFF0F0F0" Padding="5" Margin="0,2,0,2" CornerRadius="3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="5,0"/>
                                                <TextBlock Text=" (" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding ItemCount}" FontWeight="Bold"/>
                                                <TextBlock Text=")" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RequestRowStyle}">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick" 
                                  Command="{Binding DataContext.EditRequestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid Margin="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Date, StringFormat=dd.MM.yyyy}" 
                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ShiftName}" 
                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DepartmentName}" 
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="3" Text="{Binding WarehouseName}" 
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="4" Text="{Binding EquipmentName}" 
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="5" Text="{Binding PlateNumber}" 
                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding LessorName}" 
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="7" Text="{Binding VehicleBrand}" 
                               VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="{Binding RequestedCount}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="{Binding WorkedHours}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="{Binding IsWorked, Converter={StaticResource BoolToYesNo}}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="11" Text="{Binding CreatedByUser}" 
                               VerticalAlignment="Center"/>

                                        <!-- Индикатор блокировки -->
                                        <Border Grid.Column="12" Background="#FFFFD700" 
                            CornerRadius="3" Padding="2"
                            Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="🔒" FontSize="12" HorizontalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="3" Background="#FFE0E0E0">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Пользователь: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentUser.FullName}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Роль: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding CurrentUser.Role.Name}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="БД: " FontWeight="Bold"/>
                    <TextBlock Text="{Binding IsDatabaseConnected, Converter={StaticResource BooleanToStatusTextConverter}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- Всплывающее окно для добавления/редактирования заявки -->
        <Popup x:Name="EditPopup" 
               IsOpen="{Binding IsPopupOpen}"
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="15" Width="600">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock Grid.Row="0" 
                               Text="{Binding EditingRequest.IsNew, Converter={StaticResource BooleanToTextConverter}, ConverterParameter='Новая заявка;Редактирование заявки'}" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <!-- Форма редактирования -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                        <StackPanel Margin="0,0,10,0">
                            <!-- Основные поля -->
                            <GroupBox Header="Основная информация" Margin="0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Дата -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата:" VerticalAlignment="Center" Margin="5"/>
                                    <DatePicker Grid.Row="0" Grid.Column="1" 
                                                SelectedDate="{Binding EditingRequest.Date}" 
                                                Margin="5" Height="30"/>

                                    <!-- Смена -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Смена:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" 
                                              SelectedValue="{Binding EditingRequest.Shift}"
                                              SelectedValuePath="Tag" Margin="5" Height="30">
                                        <ComboBoxItem Content="Дневная" Tag="0"/>
                                        <ComboBoxItem Content="Ночная" Tag="1"/>
                                    </ComboBox>

                                    <!-- Отдел -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Отдел:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.AccessibleDepartments, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding EditingRequest.DepartmentId}"
                                              Margin="5" Height="30"/>

                                    <!-- Склад -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Склад:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="3" Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.AccessibleWarehouses, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding EditingRequest.WarehouseId}"
                                              Margin="5" Height="30"/>

                                    <!-- Техника -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Техника:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="4" Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.Equipments, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding EditingRequest.EquipmentId}"
                                              Margin="5" Height="30"/>

                                    <!-- Количество -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Количество:" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox Grid.Row="5" Grid.Column="1" 
                                             Text="{Binding EditingRequest.RequestedCount}"
                                             Margin="5" Height="30"/>
                                </Grid>
                            </GroupBox>

                            <!-- Детали -->
                            <GroupBox Header="Детали" Margin="0,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Госномер -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Госномер:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.LicensePlates, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="PlateNumber"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding EditingRequest.LicensePlateId}"
                                              Margin="5" Height="30"/>

                                    <!-- Арендодатель -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Арендодатель:" VerticalAlignment="Center" Margin="5"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" 
                                              ItemsSource="{Binding DataContext.LessorOrganizations, RelativeSource={RelativeSource AncestorType=Window}}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding EditingRequest.LessorOrganizationId}"
                                              Margin="5" Height="30"/>

                                    <!-- Отработанные часы -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Отработано часов:" VerticalAlignment="Center" Margin="5"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" 
                                             Text="{Binding EditingRequest.WorkedHours}"
                                             Margin="5" Height="30"/>
                                </Grid>
                            </GroupBox>

                            <!-- Статусы -->
                            <GroupBox Header="Статус" Margin="0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" Content="Отработано" 
                                              IsChecked="{Binding EditingRequest.IsWorked}"
                                              Margin="5"/>
                                    <CheckBox Grid.Column="1" Content="Не предоставлена" 
                                              IsChecked="{Binding EditingRequest.IsNotProvided}"
                                              Margin="5"/>
                                    <CheckBox Grid.Column="2" Content="Актировка" 
                                              IsChecked="{Binding EditingRequest.IsWeatherCancellation}"
                                              Margin="5"/>
                                </Grid>
                            </GroupBox>

                            <!-- Комментарий -->
                            <GroupBox Header="Комментарий" Margin="0,5">
                                <TextBox Text="{Binding EditingRequest.Comment}" 
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         Margin="5"/>
                            </GroupBox>

                            <!-- Информация о блокировке -->
                            <Border Background="#FFFFE0" CornerRadius="3" Padding="5"
                                    Visibility="{Binding EditingRequest.IsBlocked, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Запись заблокирована другим пользователем" 
                                           Foreground="Red" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Сохранить" Command="{Binding SaveRequestCommand}" 
                                Width="100" Height="30" Margin="5"/>
                        <Button Content="Отмена" Command="{Binding CancelEditCommand}" 
                                Width="100" Height="30" Margin="5"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>