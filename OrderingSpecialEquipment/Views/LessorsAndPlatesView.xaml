<Window x:Class="OrderingSpecialEquipment.Views.LessorsAndPlatesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1000"
        Title="Арендодатели и госномера" 
        WindowStartupLocation="CenterOwner"
        Width="1000" Height="600"
        MinWidth="800" MinHeight="400"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Style="{StaticResource ModernToolBar}" Height="Auto">
            <Button x:Name="btnAddLessor" Click="BtnAddLessor_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusBox" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Добавить арендодателя"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnEditLessor" Click="BtnEditLessor_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Редактировать арендодателя"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnDeleteLessor" Click="BtnDeleteLessor_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Удалить арендодателя"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <Button x:Name="btnAddPlate" Click="BtnAddPlate_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlusBox" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Добавить госномер"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnEditPlate" Click="BtnEditPlate_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Pencil" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Редактировать госномер"/>
                </StackPanel>
            </Button>
            <Button x:Name="btnDeletePlate" Click="BtnDeletePlate_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Удалить госномер"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <Button x:Name="btnRefresh" Click="BtnRefresh_Click" Margin="2" Padding="8,3" Style="{StaticResource ModernButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppPackIcon}" Margin="0,0,6,0"/>
                    <TextBlock Text="Обновить"/>
                </StackPanel>
            </Button>
            <Separator Style="{StaticResource ModernSeparator}"/>
            <CheckBox x:Name="chkShowInactive" Content="Показывать неактивные" 
                      VerticalAlignment="Center" Margin="5,0" 
                      Checked="ChkShowInactive_Changed" 
                      Unchecked="ChkShowInactive_Changed"
                      Style="{StaticResource ModernCheckBox}"/>
        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - арендодатели -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="5" 
                            CornerRadius="4,4,0,0">
                        <TextBlock Text="Арендодатели" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <DataGrid x:Name="dgLessors" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="DgLessors_SelectionChanged"
                              MouseDoubleClick="DgLessors_MouseDoubleClick"
                              Margin="0"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="180"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"
                                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}" 
                          Width="5"/>

            <!-- Правая часть - госномера -->
            <Border Grid.Column="2" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="5" 
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="txtPlatesTitle" 
                                   Text="Государственные номера" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <DataGrid x:Name="dgPlates" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgPlates_MouseDoubleClick"
                              Margin="0"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Госномер" Binding="{Binding PlateNumber}" Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Техника" Binding="{Binding Equipment.Name}" Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="120"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Грузоподъемность" Binding="{Binding Capacity}" Width="80"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"
                                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов" Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования арендодателя -->
        <Popup x:Name="LessorEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="500">
                <ScrollViewer MaxHeight="600" 
                              VerticalScrollBarVisibility="Auto"
                              Style="{StaticResource ModernScrollViewer}">
                    <StackPanel>
                        <TextBlock x:Name="LessorPopupTitle" 
                                   Text="Добавление арендодателя" 
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Margin="0,0,0,15"
                                   Foreground="{DynamicResource TextBrush}"/>

                        <TextBlock Text="Наименование:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorName" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="ИНН:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorINN" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Контактное лицо:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorContact" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Телефон:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorPhone" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Email:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorEmail" 
                                 Height="30" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <TextBlock Text="Адрес:" 
                                   Margin="0,5"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="txtLessorAddress" 
                                 Height="60" 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True" 
                                 Margin="0,0,0,10"
                                 Style="{StaticResource ModernTextBox}"/>

                        <CheckBox x:Name="chkLessorIsActive" 
                                  Content="Активен" 
                                  IsChecked="True" 
                                  Margin="0,5"
                                  Style="{StaticResource ModernCheckBox}"/>

                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Right" 
                                    Margin="0,20,0,0">
                            <Button x:Name="btnSaveLessor" 
                                    Content="Сохранить" 
                                    Width="100" 
                                    Height="35" 
                                    Margin="5" 
                                    Click="BtnSaveLessor_Click"
                                    Style="{StaticResource ModernButton}"/>
                            <Button x:Name="btnCancelLessor" 
                                    Content="Отмена" 
                                    Width="100" 
                                    Height="35" 
                                    Margin="5" 
                                    Click="BtnCancelLessor_Click"
                                    Style="{StaticResource ModernButton}"
                                    Background="#FF9E9E9E"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Popup для добавления/редактирования госномера -->
        <Popup x:Name="PlateEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="450">
                <StackPanel>
                    <TextBlock x:Name="PlatePopupTitle" 
                               Text="Добавление госномера" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Государственный номер:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtPlateNumber" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Техника:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="cmbPlateEquipment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" 
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernComboBox}"/>

                    <TextBlock Text="Марка:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtPlateBrand" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Год выпуска:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtPlateYear" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Грузоподъемность:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtPlateCapacity" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="VIN номер:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtPlateVIN" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <CheckBox x:Name="chkPlateIsActive" 
                              Content="Активен" 
                              IsChecked="True" 
                              Margin="0,5"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSavePlate" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSavePlate_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancelPlate" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancelPlate_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>