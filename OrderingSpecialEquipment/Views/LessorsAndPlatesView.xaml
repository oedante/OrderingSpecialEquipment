<Window x:Class="OrderingSpecialEquipment.Views.LessorsAndPlatesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1000"
        Title="Арендодатели и госномера" 
        WindowStartupLocation="CenterOwner"
        Width="1000" Height="600"
        MinWidth="800" MinHeight="400">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Background="#FFF0F0F0" Height="40">
            <Button x:Name="btnAddLessor" Content="➕ Добавить арендодателя" Click="BtnAddLessor_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnEditLessor" Content="✏️ Редактировать арендодателя" Click="BtnEditLessor_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnDeleteLessor" Content="🗑️ Удалить арендодателя" Click="BtnDeleteLessor_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnAddPlate" Content="➕ Добавить госномер" Click="BtnAddPlate_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnEditPlate" Content="✏️ Редактировать госномер" Click="BtnEditPlate_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnDeletePlate" Content="🗑️ Удалить госномер" Click="BtnDeletePlate_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Click="BtnRefresh_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <CheckBox x:Name="chkShowInactive" Content="Показывать неактивные" 
                      VerticalAlignment="Center" Margin="5,0" Checked="ChkShowInactive_Changed" Unchecked="ChkShowInactive_Changed"/>
        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - арендодатели -->
            <Border Grid.Column="0" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                        <TextBlock Text="Арендодатели" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <DataGrid x:Name="dgLessors" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="DgLessors_SelectionChanged"
                              MouseDoubleClick="DgLessors_MouseDoubleClick"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="ИНН" Binding="{Binding INN}" Width="100"/>
                            <DataGridTextColumn Header="Контактное лицо" Binding="{Binding ContactPerson}" Width="120"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" 
                          Background="#FFD0D0D0" Width="5"/>

            <!-- Правая часть - госномера -->
            <Border Grid.Column="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                        <TextBlock x:Name="txtPlatesTitle" Text="Государственные номера" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <DataGrid x:Name="dgPlates" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgPlates_MouseDoubleClick"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Госномер" Binding="{Binding PlateNumber}" Width="100"/>
                            <DataGridTextColumn Header="Техника" Binding="{Binding Equipment.Name}" Width="120"/>
                            <DataGridTextColumn Header="Марка" Binding="{Binding Brand}" Width="120"/>
                            <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Грузоподъемность" Binding="{Binding Capacity}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Background="#FFF0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования арендодателя -->
        <Popup x:Name="LessorEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="500">
                <ScrollViewer MaxHeight="600" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="LessorPopupTitle" Text="Добавление арендодателя" 
                                   FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <TextBlock Text="Наименование:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorName" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="ИНН:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorINN" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Контактное лицо:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorContact" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Телефон:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorPhone" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Email:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorEmail" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Адрес:" Margin="0,5"/>
                        <TextBox x:Name="txtLessorAddress" Height="60" TextWrapping="Wrap" 
                                 AcceptsReturn="True" Margin="0,0,0,10"/>

                        <CheckBox x:Name="chkLessorIsActive" Content="Активен" IsChecked="True" Margin="0,5"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="btnSaveLessor" Content="Сохранить" Width="100" Height="35" 
                                    Margin="5" Click="BtnSaveLessor_Click"/>
                            <Button x:Name="btnCancelLessor" Content="Отмена" Width="100" Height="35" 
                                    Margin="5" Click="BtnCancelLessor_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Popup для добавления/редактирования госномера -->
        <Popup x:Name="PlateEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="450">
                <StackPanel>
                    <TextBlock x:Name="PlatePopupTitle" Text="Добавление госномера" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Государственный номер:" Margin="0,5"/>
                    <TextBox x:Name="txtPlateNumber" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Техника:" Margin="0,5"/>
                    <ComboBox x:Name="cmbPlateEquipment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Марка:" Margin="0,5"/>
                    <TextBox x:Name="txtPlateBrand" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Год выпуска:" Margin="0,5"/>
                    <TextBox x:Name="txtPlateYear" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Грузоподъемность:" Margin="0,5"/>
                    <TextBox x:Name="txtPlateCapacity" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="VIN номер:" Margin="0,5"/>
                    <TextBox x:Name="txtPlateVIN" Height="30" Margin="0,0,0,10"/>

                    <CheckBox x:Name="chkPlateIsActive" Content="Активен" IsChecked="True" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnSavePlate" Content="Сохранить" Width="100" Height="35" 
                                Margin="5" Click="BtnSavePlate_Click"/>
                        <Button x:Name="btnCancelPlate" Content="Отмена" Width="100" Height="35" 
                                Margin="5" Click="BtnCancelPlate_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>