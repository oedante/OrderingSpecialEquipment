<Window x:Class="OrderingSpecialEquipment.Views.WarehousesAndAreasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600" d:DesignWidth="1000"
        Title="Склады и территории" 
        WindowStartupLocation="CenterOwner"
        Width="1000" Height="600"
        MinWidth="800" MinHeight="400">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Background="#FFF0F0F0" Height="40">
            <Button x:Name="btnAddWarehouse" Content="➕ Добавить склад" Click="BtnAddWarehouse_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnEditWarehouse" Content="✏️ Редактировать склад" Click="BtnEditWarehouse_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnDeleteWarehouse" Content="🗑️ Удалить склад" Click="BtnDeleteWarehouse_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnAddArea" Content="➕ Добавить территорию" Click="BtnAddArea_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnEditArea" Content="✏️ Редактировать территорию" Click="BtnEditArea_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnDeleteArea" Content="🗑️ Удалить территорию" Click="BtnDeleteArea_Click" Margin="2" Padding="8,3"/>
            <Button x:Name="btnLinkAreas" Content="🔗 Привязать территории" Click="BtnLinkAreas_Click" Margin="2" Padding="8,3"/>
            <Separator/>
            <Button x:Name="btnRefresh" Content="🔄 Обновить" Click="BtnRefresh_Click" Margin="2" Padding="8,3"/>
        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - склады -->
            <Border Grid.Column="0" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Склады" FontWeight="Bold" FontSize="14"/>
                            <ComboBox Grid.Column="1" x:Name="cmbDepartmentFilter" 
                                      Width="150" Height="25"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectionChanged="CmbDepartmentFilter_SelectionChanged"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgWarehouses" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="DgWarehouses_SelectionChanged"
                              MouseDoubleClick="DgWarehouses_MouseDoubleClick"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Активен" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" 
                          Background="#FFD0D0D0" Width="5"/>

            <!-- Правая часть - территории -->
            <Border Grid.Column="2" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFE8E8E8" Padding="5" CornerRadius="3,3,0,0">
                        <TextBlock x:Name="txtAreasTitle" Text="Территории" FontWeight="Bold" FontSize="14"/>
                    </Border>

                    <DataGrid x:Name="dgAreas" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgAreas_MouseDoubleClick"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70"/>
                            <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding AreaType}" Width="100"/>
                            <DataGridTextColumn Header="Макс. вместимость" Binding="{Binding MaxCapacity}" Width="100"/>
                            <DataGridCheckBoxColumn Header="Активна" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Background="#FFF0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" Text="Готов"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования склада -->
        <Popup x:Name="WarehouseEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource Mode=Self}}">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="450">
                <StackPanel>
                    <TextBlock x:Name="WarehousePopupTitle" Text="Добавление склада" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Наименование:" Margin="0,5"/>
                    <TextBox x:Name="txtWarehouseName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Отдел:" Margin="0,5"/>
                    <ComboBox x:Name="cmbWarehouseDepartment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Адрес:" Margin="0,5"/>
                    <TextBox x:Name="txtWarehouseAddress" Height="60" TextWrapping="Wrap" 
                             AcceptsReturn="True" Margin="0,0,0,10"/>

                    <CheckBox x:Name="chkWarehouseIsActive" Content="Активен" IsChecked="True" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnSaveWarehouse" Content="Сохранить" Width="100" Height="35" 
                                Margin="5" Click="BtnSaveWarehouse_Click"/>
                        <Button x:Name="btnCancelWarehouse" Content="Отмена" Width="100" Height="35" 
                                Margin="5" Click="BtnCancelWarehouse_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup для добавления/редактирования территории -->
        <Popup x:Name="AreaEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="400">
                <StackPanel>
                    <TextBlock x:Name="AreaPopupTitle" Text="Добавление территории" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Наименование:" Margin="0,5"/>
                    <TextBox x:Name="txtAreaName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Тип территории:" Margin="0,5"/>
                    <ComboBox x:Name="cmbAreaType" Height="30" Margin="0,0,0,10">
                        <ComboBoxItem Content="Разгрузка"/>
                        <ComboBoxItem Content="Погрузка"/>
                        <ComboBoxItem Content="Хранение"/>
                        <ComboBoxItem Content="Открытое хранение"/>
                        <ComboBoxItem Content="Крытое хранение"/>
                        <ComboBoxItem Content="Ремонтная зона"/>
                    </ComboBox>

                    <TextBlock Text="Максимальная вместимость:" Margin="0,5"/>
                    <TextBox x:Name="txtAreaCapacity" Text="" Height="30" Margin="0,0,0,10"/>

                    <CheckBox x:Name="chkAreaIsActive" Content="Активна" IsChecked="True" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnSaveArea" Content="Сохранить" Width="100" Height="35" 
                                Margin="5" Click="BtnSaveArea_Click"/>
                        <Button x:Name="btnCancelArea" Content="Отмена" Width="100" Height="35" 
                                Margin="5" Click="BtnCancelArea_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup для привязки территорий к складу -->
        <Popup x:Name="LinkAreasPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False">
            <Border Background="White" BorderBrush="#FF404040" BorderThickness="1" 
                    CornerRadius="5" Padding="20" Width="500" Height="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Привязка территорий к складу" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                    <ListBox Grid.Row="1" x:Name="lbAreasForLinking" 
                             SelectionMode="Multiple"
                             DisplayMemberPath="Name"
                             Margin="0,5"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="btnSaveLinks" Content="Сохранить" Width="100" Height="35" 
                                Margin="5" Click="BtnSaveLinks_Click"/>
                        <Button x:Name="btnCancelLinks" Content="Отмена" Width="100" Height="35" 
                                Margin="5" Click="BtnCancelLinks_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>