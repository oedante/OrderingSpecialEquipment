<Window x:Class="OrderingSpecialEquipment.Views.WarehousesAndAreasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:converters="clr-namespace:OrderingSpecialEquipment.Converters"
        mc:Ignorable="d" 
        d:DesignHeight="600"
        Title="Склады и территории" 
        WindowStartupLocation="CenterOwner"
        Width="1250" Height="600"
        MinWidth="1000" MinHeight="600"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.Resources>
        <converters:BooleanToYesNoConverter x:Key="BoolToYesNo"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="10" Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <ToolBar Grid.Row="0" Style="{StaticResource ModernToolBar}" Height="Auto">
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnAddWarehouse" Grid.Column="0" Content="➕ Добавить" 
                    Click="BtnAddWarehouse_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Button x:Name="btnEditWarehouse" Grid.Column="1" Content="✏️ Редактировать" 
                    Click="BtnEditWarehouse_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Button x:Name="btnDeleteWarehouse" Grid.Column="2" Content="🗑️ Удалить" 
                    Click="BtnDeleteWarehouse_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>

                <!-- Разделитель -->
                <GridSplitter Grid.Column="4" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}" 
                          Width="5"/>

                <Button x:Name="btnAddArea" Grid.Column="5" Content="➕ Добавить" 
                    Click="BtnAddArea_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Button x:Name="btnEditArea" Grid.Column="6" Content="✏️ Редактировать" 
                    Click="BtnEditArea_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Button x:Name="btnDeleteArea" Grid.Column="7" Content="🗑️ Удалить" 
                    Click="BtnDeleteArea_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Button x:Name="btnLinkAreas" Grid.Column="8" Content="🔗 Привязать" 
                    Click="BtnLinkAreas_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
                <Separator Style="{StaticResource ModernSeparator}"/>
                <Button x:Name="btnRefresh" Grid.Column="9" Content="🔄 Обновить" 
                    Click="BtnRefresh_Click" 
                    Margin="2" Padding="8,3"
                    Style="{StaticResource ModernButton}"/>
            </Grid>
        </ToolBar>

        <!-- Основная область -->
        <Grid Grid.Row="1" Margin="0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="488"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая часть - склады -->
            <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="5" 
                            CornerRadius="4,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Склады" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <ComboBox Grid.Column="1" x:Name="cmbDepartmentFilter" 
                                      Width="150" 
                                      Height="25"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectionChanged="CmbDepartmentFilter_SelectionChanged"
                                      Style="{StaticResource ModernComboBox}"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgWarehouses" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="DgWarehouses_SelectionChanged"
                              MouseDoubleClick="DgWarehouses_MouseDoubleClick"
                              Margin="0"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding Id}" 
                                                Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Наименование" 
                                                Binding="{Binding Name}" 
                                                Width="*"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Адрес" 
                                                Binding="{Binding Address}" 
                                                Width="150"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridCheckBoxColumn Header="Активен" 
                                                    Binding="{Binding IsActive}" 
                                                    Width="70"
                                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          HorizontalAlignment="Stretch" 
                          Background="{DynamicResource BorderBrush}" 
                          Width="5"/>

            <!-- Правая часть - территории -->
            <Border Grid.Column="2" 
                    BorderBrush="{DynamicResource BorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource HeaderBackgroundBrush}" 
                            Padding="5" 
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="txtAreasTitle" 
                                   Text="Территории" 
                                   FontWeight="Bold" 
                                   FontSize="14"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </Border>

                    <DataGrid x:Name="dgAreas" Grid.Row="1" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgAreas_MouseDoubleClick"
                              Margin="0"
                              Style="{StaticResource ModernDataGrid}"
                              RowStyle="{StaticResource ModernDataGridRow}"
                              CellStyle="{StaticResource ModernDataGridCell}"
                              ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                              Background="{DynamicResource BackgroundBrush}"
                              Foreground="{DynamicResource TextBrush}"
                              RowBackground="{DynamicResource BackgroundBrush}"
                              AlternatingRowBackground="{DynamicResource DataGridAlternatingRowBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" 
                                                Binding="{Binding Id}" 
                                                Width="70"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Наименование" 
                                                Binding="{Binding Name}" 
                                                Width="*"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Тип" 
                                                Binding="{Binding AreaType}" 
                                                Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridTextColumn Header="Макс. вместимость" 
                                                Binding="{Binding MaxCapacity}" 
                                                Width="100"
                                                CellStyle="{StaticResource ModernDataGridCell}"/>
                            <DataGridCheckBoxColumn Header="Активна" 
                                                    Binding="{Binding IsActive}" 
                                                    Width="70"
                                                    CellStyle="{StaticResource ModernDataGridCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Статус бар -->
        <StatusBar Grid.Row="2" Style="{StaticResource ModernStatusBar}">
            <StatusBarItem>
                <TextBlock x:Name="txtStatus" 
                           Text="Готов" 
                           Foreground="{DynamicResource TextBrush}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Popup для добавления/редактирования склада -->
        <Popup x:Name="WarehouseEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="450">
                <StackPanel>
                    <TextBlock x:Name="WarehousePopupTitle" 
                               Text="Добавление склада" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Наименование:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtWarehouseName" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Отдел:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="cmbWarehouseDepartment" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Height="30" 
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernComboBox}"/>

                    <TextBlock Text="Адрес:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtWarehouseAddress" 
                             Height="60" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <CheckBox x:Name="chkWarehouseIsActive" 
                              Content="Активен" 
                              IsChecked="True" 
                              Margin="0,5"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSaveWarehouse" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSaveWarehouse_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancelWarehouse" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancelWarehouse_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup для добавления/редактирования территории -->
        <Popup x:Name="AreaEditPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="400">
                <StackPanel>
                    <TextBlock x:Name="AreaPopupTitle" 
                               Text="Добавление территории" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <TextBlock Text="Наименование:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtAreaName" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <TextBlock Text="Тип территории:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <ComboBox x:Name="cmbAreaType" 
                              Height="30" 
                              Margin="0,0,0,10"
                              Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="Разгрузка" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="Погрузка" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="Хранение" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="Открытое хранение" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="Крытое хранение" Style="{StaticResource ModernComboBoxItem}"/>
                        <ComboBoxItem Content="Ремонтная зона" Style="{StaticResource ModernComboBoxItem}"/>
                    </ComboBox>

                    <TextBlock Text="Максимальная вместимость:" 
                               Margin="0,5"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBox x:Name="txtAreaCapacity" 
                             Text="" 
                             Height="30" 
                             Margin="0,0,0,10"
                             Style="{StaticResource ModernTextBox}"/>

                    <CheckBox x:Name="chkAreaIsActive" 
                              Content="Активна" 
                              IsChecked="True" 
                              Margin="0,5"
                              Style="{StaticResource ModernCheckBox}"/>

                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSaveArea" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSaveArea_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancelArea" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancelArea_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Popup для привязки территорий к складу -->
        <Popup x:Name="LinkAreasPopup" 
               Placement="Center"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               StaysOpen="False"
               Style="{StaticResource ModernPopup}">
            <Border Style="{StaticResource PopupBorderStyle}" Width="500" Height="400">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" 
                               Text="Привязка территорий к складу" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Margin="0,0,0,15"
                               Foreground="{DynamicResource TextBrush}"/>

                    <ListBox Grid.Row="1" x:Name="lbAreasForLinking" 
                             SelectionMode="Multiple"
                             DisplayMemberPath="Name"
                             Margin="0,5"
                             Style="{StaticResource ModernListBox}"
                             Background="{DynamicResource BackgroundBrush}"
                             Foreground="{DynamicResource TextBrush}"/>

                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right" 
                                Margin="0,20,0,0">
                        <Button x:Name="btnSaveLinks" 
                                Content="Сохранить" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnSaveLinks_Click"
                                Style="{StaticResource ModernButton}"/>
                        <Button x:Name="btnCancelLinks" 
                                Content="Отмена" 
                                Width="100" 
                                Height="35" 
                                Margin="5" 
                                Click="BtnCancelLinks_Click"
                                Style="{StaticResource ModernButton}"
                                Background="#FF9E9E9E"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</Window>