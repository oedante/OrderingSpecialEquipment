<Window x:Class="OrderingSpecialEquipment.Views.ConnectionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:OrderingSpecialEquipment.Views"
        mc:Ignorable="d" d:DesignWidth="500"
        Title="Настройки подключения к базе данных" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Height="566">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Настройки подключения к БД" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Форма настроек -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">

            <GroupBox Header="Тип базы данных" Margin="0,5">
                <StackPanel>
                    <RadioButton x:Name="rbPostgreSQL" Content="PostgreSQL" 
                                 IsChecked="True" Margin="5" GroupName="DbType"/>
                    <RadioButton x:Name="rbSqlServer" Content="MS SQL Server" 
                                 Margin="5" GroupName="DbType"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Параметры подключения" Margin="0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Сервер -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Сервер:" 
                               VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtServer" Grid.Row="0" Grid.Column="1" 
                             Text="localhost" Margin="5" Height="30"/>

                    <!-- Порт -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт:" 
                               VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtPort" Grid.Row="1" Grid.Column="1" 
                             Text="5432" Margin="5" Height="30"/>

                    <!-- Имя БД -->
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="База данных:" 
                               VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtDatabase" Grid.Row="2" Grid.Column="1" 
                             Text="OrderingSpecialEquipment" Margin="5" Height="30"/>

                    <!-- Пользователь -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Пользователь:" 
                               VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtUsername" Grid.Row="3" Grid.Column="1" 
                             Text="postgres" Margin="5" Height="30"/>

                    <!-- Пароль -->
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Пароль:" 
                               VerticalAlignment="Center" Margin="5"/>
                    <PasswordBox x:Name="txtPassword" Grid.Row="4" Grid.Column="1" 
                                 Margin="5" Height="30"/>

                    <!-- Разделитель -->
                    <Border Grid.Row="5" Grid.ColumnSpan="2" 
                            Height="1" Background="#FFE0E0E0" Margin="5"/>

                    <!-- Строка подключения (только для просмотра) -->
                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Строка подключения:" 
                               VerticalAlignment="Top" Margin="5"/>
                    <TextBox x:Name="txtConnectionString" Grid.Row="6" Grid.Column="1" 
                             IsReadOnly="True" Background="#FFF5F5F5" 
                             TextWrapping="Wrap" MinHeight="60" Margin="5"/>
                </Grid>
            </GroupBox>

            <!-- Индикатор успешного подключения -->
            <Border x:Name="borderSuccess"  
                    CornerRadius="3" Padding="10" Margin="0,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtSuccess" Foreground="Green" 
                           Text="Подключение успешно установлено!"/>
            </Border>

            <!-- Индикатор ошибки -->
            <Border x:Name="borderError" Background="#FFFFE0E0" 
                    CornerRadius="3" Padding="10" Margin="0,5"
                    Visibility="Collapsed">
                <TextBlock x:Name="txtError" Foreground="Red" 
                           Text="Ошибка подключения!"/>
            </Border>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnTest" Content="Проверить подключение" 
                    Width="180" Height="35" Margin="5" Click="BtnTest_Click"/>
            <Button x:Name="btnSave" Content="Сохранить" 
                    Width="100" Height="35" Margin="5" Click="BtnSave_Click" IsEnabled="False"/>
            <Button x:Name="btnCancel" Content="Отмена" 
                    Width="100" Height="35" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>